-- adapted from SQLite test/descidx1.test, descidx2.test, descidx3.test
-- DESC indexes for output ordering. Companion to 40.1-pk-desc-direction (PK DESC)
-- and 10.5-indexes (single-column DESC creation). Pins composite mixed-direction
-- indexes, NULL ordering through DESC indexes, and range queries on DESC indexes.
--
-- requires-capability: standalone-index-ddl

-- =====================================================
-- 1. Single-column DESC index — descending traversal
-- =====================================================
create table d_one (id integer primary key, score integer);
insert into d_one values (1, 30);
insert into d_one values (2, 10);
insert into d_one values (3, 50);
insert into d_one values (4, 20);
insert into d_one values (5, 40);

create index ix_d_one_score on d_one(score desc);

-- ORDER BY DESC matches the index direction
select id, score from d_one order by score desc;
→ [{"id":3,"score":50},{"id":5,"score":40},{"id":1,"score":30},{"id":4,"score":20},{"id":2,"score":10}]

-- ORDER BY ASC also correct (engine may reverse-scan or sort, either way result is right)
select id, score from d_one order by score;
→ [{"id":2,"score":10},{"id":4,"score":20},{"id":1,"score":30},{"id":5,"score":40},{"id":3,"score":50}]

drop table d_one;

-- =====================================================
-- 2. Composite mixed-direction index (ASC, DESC)
-- =====================================================
create table d_mix (id integer primary key, category text, score integer);
insert into d_mix values (1, 'a', 10);
insert into d_mix values (2, 'a', 30);
insert into d_mix values (3, 'a', 20);
insert into d_mix values (4, 'b', 5);
insert into d_mix values (5, 'b', 25);

create index ix_d_mix on d_mix(category asc, score desc);

-- ORDER BY matching the index direction exactly
select id, category, score from d_mix order by category asc, score desc;
→ [{"id":2,"category":"a","score":30},{"id":3,"category":"a","score":20},{"id":1,"category":"a","score":10},{"id":5,"category":"b","score":25},{"id":4,"category":"b","score":5}]

-- Equality on the leading key followed by DESC scan of the trailing key
select id, score from d_mix where category = 'a' order by score desc;
→ [{"id":2,"score":30},{"id":3,"score":20},{"id":1,"score":10}]

drop table d_mix;

-- =====================================================
-- 3. DESC index with NULLs
-- =====================================================
create table d_null (id integer primary key, val text null);
insert into d_null values (1, 'z');
insert into d_null values (2, null);
insert into d_null values (3, 'a');
insert into d_null values (4, null);
insert into d_null values (5, 'm');

create index ix_d_null on d_null(val desc);

-- Bare DESC sort. The engine places NULLs FIRST for BOTH directions -- placement is
-- absolute, never conditioned on ASC/DESC. A DESC index walk emits them LAST, so the
-- index must decline the ordering claim here and leave the Sort in place; the answer is
-- the same with or without ix_d_null.
select val from d_null order by val desc;
→ [{"val":null},{"val":null},{"val":"z"},{"val":"m"},{"val":"a"}]

-- A NULL-excluding filter evicts every NULL, so the DESC index may claim the ordering
-- again -- the exception that keeps `where val is not null order by val desc` fast.
select val from d_null where val is not null order by val desc;
→ [{"val":"z"},{"val":"m"},{"val":"a"}]

-- Ascending over the DESC index: a backwards walk runs the column ascending, so it emits
-- the NULLs first as the engine wants
select val from d_null order by val;
→ [{"val":null},{"val":null},{"val":"a"},{"val":"m"},{"val":"z"}]

-- Explicit NULLs FIRST under DESC
select val from d_null order by val desc nulls first;
→ [{"val":null},{"val":null},{"val":"z"},{"val":"m"},{"val":"a"}]

-- Explicit NULLs LAST under DESC
select val from d_null order by val desc nulls last;
→ [{"val":"z"},{"val":"m"},{"val":"a"},{"val":null},{"val":null}]

drop table d_null;

-- =====================================================
-- 4. Range scan on DESC index
-- =====================================================
create table d_range (id integer primary key, n integer);
insert into d_range values (1, 100);
insert into d_range values (2, 50);
insert into d_range values (3, 75);
insert into d_range values (4, 25);
insert into d_range values (5, 90);

create index ix_d_range on d_range(n desc);

-- Half-bounded range, DESC ordering
select n from d_range where n >= 60 order by n desc;
→ [{"n":100},{"n":90},{"n":75}]

-- Bounded range, DESC ordering
select n from d_range where n between 30 and 80 order by n desc;
→ [{"n":75},{"n":50}]

-- Same bounded range, ASC ordering still correct
select n from d_range where n between 30 and 80 order by n;
→ [{"n":50},{"n":75}]

drop table d_range;

-- =====================================================
-- 5. DESC index on TEXT — lexicographic descending
-- =====================================================
create table d_text (id integer primary key, name text);
insert into d_text values (1, 'banana');
insert into d_text values (2, 'apple');
insert into d_text values (3, 'cherry');
insert into d_text values (4, 'date');

create index ix_d_text on d_text(name desc);

select name from d_text order by name desc;
→ [{"name":"date"},{"name":"cherry"},{"name":"banana"},{"name":"apple"}]

-- Range on TEXT DESC index
select name from d_text where name >= 'b' order by name desc;
→ [{"name":"date"},{"name":"cherry"},{"name":"banana"}]

drop table d_text;

-- =====================================================
-- 6. Ascending index and primary key read backwards
-- =====================================================
-- A descending ORDER BY over an ascending index (or primary key) may be served by
-- walking it backwards instead of sorting; a backend that cannot still sorts. Answers
-- only -- the plan differs per backend.
create table r_asc (id integer primary key, c integer, n integer null, k integer, r integer);
create index ix_r_asc_c on r_asc(c);
create index ix_r_asc_n on r_asc(n);
create index ix_r_asc_kr on r_asc(k, r);
insert into r_asc values (1, 10, 3, 1, 5);
insert into r_asc values (2, 20, null, 1, 7);
insert into r_asc values (3, 10, 1, 0, 9);
insert into r_asc values (4, 30, 2, 1, 6);
insert into r_asc values (5, 20, null, 2, 1);
insert into r_asc values (6, 10, 4, 1, 8);

-- Ties on an ascending index read descending. SQL leaves the order of rows sharing a
-- value open and the backends differ (a backwards walk gives reverse primary-key order, a
-- sort keeps scan order), so only the sorted column is projected.
select c from r_asc order by c desc;
→ [{"c":30},{"c":20},{"c":20},{"c":10},{"c":10},{"c":10}]

-- Primary key read backwards
select id from r_asc order by id desc limit 3;
→ [{"id":6},{"id":5},{"id":4}]

-- A nullable ascending column read descending: NULLs still come first, so a backwards
-- walk (which emits them last) must not serve this
select n from r_asc order by n desc;
→ [{"n":null},{"n":null},{"n":4},{"n":3},{"n":2},{"n":1}]

-- With the NULLs filtered out the backwards walk may serve it
select n from r_asc where n is not null order by n desc;
→ [{"n":4},{"n":3},{"n":2},{"n":1}]

select n from r_asc where n > 1 order by n desc;
→ [{"n":4},{"n":3},{"n":2}]

-- Equality on the leading column of (k, r), trailing column read descending: the walk
-- must start from the END of the k = 1 group
select r from r_asc where k = 1 order by r desc;
→ [{"r":8},{"r":7},{"r":6},{"r":5}]

select r from r_asc where k = 1 and r <= 7 order by r desc;
→ [{"r":7},{"r":6},{"r":5}]

-- A partial flip of (k, r) is neither the index order nor its reverse
select k, r from r_asc order by k desc, r asc;
→ [{"k":2,"r":1},{"k":1,"r":5},{"k":1,"r":6},{"k":1,"r":7},{"k":1,"r":8},{"k":0,"r":9}]

-- Composite primary key, range on its leading column, read backwards: every row AT the
-- bound must come back, not just those below it
create table r_pk (a integer, b integer, v text, primary key (a, b));
insert into r_pk values (3, 1, 'p');
insert into r_pk values (5, 1, 'q');
insert into r_pk values (5, 2, 'r');
insert into r_pk values (5, 3, 's');
insert into r_pk values (7, 1, 't');

select a, b from r_pk where a <= 5 order by a desc, b desc;
→ [{"a":5,"b":3},{"a":5,"b":2},{"a":5,"b":1},{"a":3,"b":1}]

select a, b from r_pk where a >= 5 order by a desc, b desc;
→ [{"a":7,"b":1},{"a":5,"b":3},{"a":5,"b":2},{"a":5,"b":1}]

select a, b from r_pk where a < 5 order by a desc, b desc;
→ [{"a":3,"b":1}]

select b from r_pk where a = 5 order by b desc;
→ [{"b":3},{"b":2},{"b":1}]

-- The same reads over rows staged in an open transaction
begin;
insert into r_pk values (5, 4, 'u');
insert into r_pk values (4, 1, 'w');
update r_pk set v = 'P' where a = 3 and b = 1;
delete from r_pk where a = 5 and b = 2;
insert into r_asc values (7, 25, 5, 1, 4);
update r_asc set c = 40 where id = 1;
delete from r_asc where id = 4;

select a, b, v from r_pk where a <= 5 order by a desc, b desc;
→ [{"a":5,"b":4,"v":"u"},{"a":5,"b":3,"v":"s"},{"a":5,"b":1,"v":"q"},{"a":4,"b":1,"v":"w"},{"a":3,"b":1,"v":"P"}]

select c from r_asc order by c desc;
→ [{"c":40},{"c":25},{"c":20},{"c":20},{"c":10},{"c":10}]

select r from r_asc where k = 1 order by r desc;
→ [{"r":8},{"r":7},{"r":5},{"r":4}]

select id from r_asc order by id desc limit 2;
→ [{"id":7},{"id":6}]
commit;

select a, b from r_pk order by a desc, b desc;
→ [{"a":7,"b":1},{"a":5,"b":4},{"a":5,"b":3},{"a":5,"b":1},{"a":4,"b":1},{"a":3,"b":1}]

drop table r_pk;
drop table r_asc;
