-- 05.1.1-secondary-index-range-scan.sqllogic
--
-- requires-capability: standalone-index-ddl
--
-- Carved out of 05.1-composite-pk-range-scan: that file's subject is leading-column
-- range scans over composite (and DESC-leading composite) PRIMARY KEYS, which need
-- no index DDL at all. These two scenarios build a standalone multi-column SECONDARY
-- index purely as a comparison point for the same seek-key bug, so they lived only to
-- cover the secondary branch — and would have made the whole PK file unrunnable on a
-- backend without first-class CREATE INDEX.
--
-- Subject: a range scan bounded on the leading column of a multi-column SECONDARY
-- index must return every matching row (ASC-leading and DESC-leading variants).

PRAGMA default_vtab_module='memory';

-- Multi-column SECONDARY index, leading-column range scan. The PK is a single
-- scalar column so the primary path is unaffected; force the secondary index
-- to drive the scan via a leading-column range on a composite index.
CREATE TABLE idx_t (id INTEGER PRIMARY KEY, k INTEGER, name TEXT, v TEXT);
CREATE INDEX idx_kn ON idx_t (k, name);
INSERT INTO idx_t VALUES (1, 10, 'a', 'p'), (2, 20, 'b', 'q'), (3, 30, 'c', 'r');

SELECT id FROM idx_t WHERE k >= 10 ORDER BY k;
→ [{"id":1},{"id":2},{"id":3}]

SELECT id FROM idx_t WHERE k >= 15 ORDER BY k;
→ [{"id":2},{"id":3}]

SELECT id FROM idx_t WHERE k >= 10 AND k < 30 ORDER BY k;
→ [{"id":1},{"id":2}]

DROP TABLE idx_t;

-- Multi-column SECONDARY index with a DESC leading column. The secondary
-- branch carries isDescFirstColumn handling (the lower-bound wrap is
-- direction-independent), so a leading-column range still returns every row.
-- (The primary branch lacks this handling — tracked separately.)
CREATE TABLE idx_d (id INTEGER PRIMARY KEY, k INTEGER, name TEXT, v TEXT);
CREATE INDEX idx_kn_d ON idx_d (k DESC, name);
INSERT INTO idx_d VALUES (1, 10, 'a', 'p'), (2, 20, 'b', 'q'), (3, 30, 'c', 'r');

SELECT id FROM idx_d WHERE k >= 15 ORDER BY k;
→ [{"id":2},{"id":3}]

-- Upper-bound range on the DESC-leading secondary index. An ascending physical
-- walk over a DESC-leading composite index seeks from the upper bound; that
-- scalar bound is wrapped in a single-element array so the comparator positions
-- the seek at the bound rather than at a tree extreme. NOTE: the pre-wrap scalar
-- form was inefficient (a bare scalar sorts to one tree end, forcing a full
-- forward scan) but still correct here — it landed at the start of the walk, so
-- this case is a result-correctness assertion, not a row-drop regression guard.
SELECT id FROM idx_d WHERE k <= 25 ORDER BY k;
→ [{"id":1},{"id":2}]

DROP TABLE idx_d;

-- Equality on the leading column of a multi-column secondary index. The first, middle,
-- last and missing groups each guard a different walk failure (see the primary key
-- counterpart in 05.1-composite-pk-range-scan). `k` is nullable so that stored NULLs
-- form a group of their own.
create table sfx (id integer primary key, k text null, r integer, x integer);
create index sfx_kr on sfx (k, r);
insert into sfx values (1, 'b', 1, 10), (2, 'b', 2, 20), (3, 'd', 1, 30), (4, 'd', 2, 40), (5, 'f', 1, 50), (6, 'f', 2, 60), (7, null, 1, 70);

select x from sfx where k = 'b' order by r;
→ [{"x":10},{"x":20}]

select x from sfx where k = 'd' order by r;
→ [{"x":30},{"x":40}]

select x from sfx where k = 'f' order by r;
→ [{"x":50},{"x":60}]

select x from sfx where k = 'a';
→ []

select x from sfx where k = 'c';
→ []

select x from sfx where k = 'g';
→ []

-- A parameter bound to NULL matches nothing, not the group of stored NULLs.
-- params: [null]
select x from sfx where k = ?;
→ []

-- params: ["d"]
select x from sfx where k = ? order by r;
→ [{"x":30},{"x":40}]

select x from sfx where k is null;
→ [{"x":70}]

-- The same group read through a transaction's own writes, then after they roll back.
begin;
insert into sfx values (8, 'd', 3, 80);
update sfx set x = 41 where id = 4;
delete from sfx where id = 3;
update sfx set k = 'd' where id = 1;

select id, x from sfx where k = 'd' order by r, id;
→ [{"id":1,"x":10},{"id":4,"x":41},{"id":8,"x":80}]

select id from sfx where k = 'b';
→ [{"id":2}]

rollback;

select id, x from sfx where k = 'd' order by r;
→ [{"id":3,"x":30},{"id":4,"x":40}]

drop table sfx;

-- Over a DESC leading column.
create table sfxd (id integer primary key, k text, r integer);
create index sfxd_kr on sfxd (k desc, r);
insert into sfxd values (1, 'b', 2), (2, 'b', 1), (3, 'd', 2), (4, 'd', 1), (5, 'f', 2), (6, 'f', 1);

select id from sfxd where k = 'f' order by r;
→ [{"id":6},{"id":5}]

select id from sfxd where k = 'd' order by r;
→ [{"id":4},{"id":3}]

select id from sfxd where k = 'b' order by r;
→ [{"id":2},{"id":1}]

select id from sfxd where k = 'c';
→ []

drop table sfxd;

-- The ordering a seek provides, from a DESC column after the prefix.
create table sfxo (id integer primary key, k text, r integer);
create index sfxo_kr on sfxo (k, r desc);
insert into sfxo values (1, 'a', 1), (2, 'a', 3), (3, 'a', 2), (4, 'b', 9);

select r from sfxo where k = 'a' order by r desc;
→ [{"r":3},{"r":2},{"r":1}]

select r from sfxo where k = 'a' order by r desc limit 1;
→ [{"r":3}]

drop table sfxo;

-- A NOCASE index: a NOCASE predicate reads the whole group, and a BINARY one reads the
-- group and filters it down to the one spelling.
create table sfxn (id integer primary key, k text collate nocase, r integer);
create index sfxn_kr on sfxn (k, r);
insert into sfxn values (1, 'a', 1), (2, 'A', 2), (3, 'a', 3), (4, 'b', 4);

select id from sfxn where k = 'a' order by r;
→ [{"id":1},{"id":2},{"id":3}]

select id from sfxn where k = 'a' collate binary order by r;
→ [{"id":1},{"id":3}]

select id from sfxn where k = 'A' collate binary order by r;
→ [{"id":2}]

drop table sfxn;

-- A NOCASE predicate over a BINARY index cannot use the index, whose groups it spans, so
-- the index's order cannot replace the sort. With two spellings `r` restarts in each
-- group of a walk; with one spelling a scan of the table emits rows in `id` order.
create table sfxb (id integer primary key, k text collate binary, r integer);
create index sfxb_kr on sfxb (k, r);
insert into sfxb values (1, 'A', 2), (2, 'a', 1), (3, 'A', 0), (4, 'b', 9), (5, 'c', 3), (6, 'c', 1), (7, 'c', 2);

select r from sfxb where k = 'a' collate nocase order by r;
→ [{"r":0},{"r":1},{"r":2}]

select r from sfxb where k = 'c' collate nocase order by r;
→ [{"r":1},{"r":2},{"r":3}]

select r from sfxb where k = 'c' collate nocase order by r limit 2;
→ [{"r":1},{"r":2}]

select r from sfxb where k = 'a' collate nocase and r > 0 order by r;
→ [{"r":1},{"r":2}]

select min(r) as m from sfxb where k = 'c' collate nocase;
→ [{"m":1}]

select min(r) as m from sfxb where k = 'a' collate nocase;
→ [{"m":0}]

drop table sfxb;

-- An index collated differently from its column does not walk in that column's order,
-- so it cannot replace a sort, serve a boundary read, or drive a merge join. Over BINARY
-- `s` the index emits a, B, c where the column sorts B, a, c.
create table sfxc (id integer primary key, g text, s text);
create index sfxc_gs on sfxc (g, s collate nocase);
create index sfxc_s on sfxc (s collate nocase);
insert into sfxc values (1, 'g', 'a'), (2, 'g', 'B'), (3, 'g', 'c');

select s from sfxc order by s;
→ [{"s":"B"},{"s":"a"},{"s":"c"}]

select s from sfxc where g = 'g' order by s;
→ [{"s":"B"},{"s":"a"},{"s":"c"}]

select min(s) as m from sfxc where g = 'g';
→ [{"m":"B"}]

select x.s from sfxc x join sfxc y on x.s = y.s where x.g = 'g' and y.g = 'g' order by x.id;
→ [{"s":"a"},{"s":"B"},{"s":"c"}]

drop table sfxc;

-- The reverse: over NOCASE `s` a BINARY index emits B, a, c where the column sorts a, B, c.
create table sfxr (id integer primary key, g text, s text collate nocase);
create index sfxr_gs on sfxr (g, s collate binary);
insert into sfxr values (1, 'g', 'a'), (2, 'g', 'B'), (3, 'g', 'c');

select s from sfxr where g = 'g' order by s;
→ [{"s":"a"},{"s":"B"},{"s":"c"}]

select min(s) as m from sfxr where g = 'g';
→ [{"m":"a"}]

select x.s from sfxr x join sfxr y on x.s = y.s where x.g = 'g' and y.g = 'g' order by x.id;
→ [{"s":"a"},{"s":"B"},{"s":"c"}]

drop table sfxr;
