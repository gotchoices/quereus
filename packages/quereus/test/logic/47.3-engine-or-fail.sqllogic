-- INSERT OR FAIL combined with engine-level constraints (NOT NULL / CHECK).
-- The 47.2 case 7 covers OR FAIL + UNIQUE; this fills in the engine-level
-- constraints so we know the FAIL→commit-prior-rows path applies uniformly.

-- ===================================
-- 1. OR FAIL on NOT NULL violation — earlier rows remain
-- ===================================

create table t_nn (id integer primary key, name text);
insert into t_nn values (10, 'pre');

insert or fail into t_nn values (1, 'a'), (2, 'b'), (3, null), (4, 'd');
-- error: NOT NULL

select id, name from t_nn order by id;
→ [{"id":1,"name":"a"},{"id":2,"name":"b"},{"id":10,"name":"pre"}]

drop table t_nn;

-- ===================================
-- 2. OR FAIL on CHECK violation — earlier rows remain
-- ===================================

create table t_ck (id integer primary key, n integer check (n > 0));
insert into t_ck values (10, 100);

insert or fail into t_ck values (1, 1), (2, 2), (3, -1), (4, 4);
-- error: CHECK

select id, n from t_ck order by id;
→ [{"id":1,"n":1},{"id":2,"n":2},{"id":10,"n":100}]

drop table t_ck;

-- ===================================
-- 3. OR ROLLBACK on engine-level CHECK rolls back the enclosing transaction
-- ===================================

create table t_rb (id integer primary key, n integer check (n > 0));
insert into t_rb values (1, 10);
-- run

begin;
   insert into t_rb values (2, 20);
   insert or rollback into t_rb values (3, -5);
   -- error: CHECK

-- The enclosing transaction was auto-rolled-back; only the pre-tx insert remains.
select id, n from t_rb order by id;
→ [{"id":1,"n":10}]

drop table t_rb;

-- ===================================
-- 4. OR FAIL nested under a user-level SAVEPOINT — ROLLBACK TO must work
-- ===================================
-- The per-row OR FAIL savepoint (`__or_fail_N`) is created and released
-- inside the bracket. After the bracket ends, the user-level savepoint
-- stack must remain aligned with TxnMgr's. If the per-row create/release
-- did not broadcast to connections (the bug this exercises), per-connection
-- stacks would drift relative to TxnMgr and ROLLBACK TO sp would restore
-- the wrong layer.

create table t_sp (id integer primary key, name text);
insert into t_sp values (10, 'pre');
-- run

begin;
savepoint sp1;
-- OR FAIL succeeds for all rows: per-row create/release brackets must
-- compose cleanly with the surrounding user savepoint.
insert or fail into t_sp values (1, 'a'), (2, 'b'), (3, 'c');
select id, name from t_sp order by id;
→ [{"id":1,"name":"a"},{"id":2,"name":"b"},{"id":3,"name":"c"},{"id":10,"name":"pre"}]

-- ROLLBACK TO sp1: must undo all three OR-FAIL rows, leaving only `pre`.
rollback to savepoint sp1;
select id, name from t_sp order by id;
→ [{"id":10,"name":"pre"}]

-- Re-INSERT under the same sp1 to verify the stack is still well-formed.
insert or fail into t_sp values (4, 'd'), (5, 'e');
select id, name from t_sp order by id;
→ [{"id":4,"name":"d"},{"id":5,"name":"e"},{"id":10,"name":"pre"}]

release savepoint sp1;
commit;

select id, name from t_sp order by id;
→ [{"id":4,"name":"d"},{"id":5,"name":"e"},{"id":10,"name":"pre"}]

drop table t_sp;

-- ===================================
-- 5. OR FAIL whose middle row fails, nested under a SAVEPOINT
-- ===================================
-- When OR FAIL aborts mid-statement, the per-row __or_fail_N savepoint for
-- the failing row is rolled back + released. Earlier rows commit. The
-- surrounding sp1 must still be reachable for a follow-on rollback.

create table t_spf (id integer primary key, n integer check (n > 0));
insert into t_spf values (100, 99);
-- run

begin;
savepoint sp1;
insert or fail into t_spf values (1, 1), (2, 2), (3, -1), (4, 4);
-- error: CHECK

-- Rows 1,2 survive; 3,4 do not. Pre-row 100 also survives.
select id, n from t_spf order by id;
→ [{"id":1,"n":1},{"id":2,"n":2},{"id":100,"n":99}]

-- The user-level sp1 is still aligned: rollback wipes the OR-FAIL survivors.
rollback to savepoint sp1;
select id, n from t_spf order by id;
→ [{"id":100,"n":99}]

release savepoint sp1;
commit;

drop table t_spf;

-- ===================================
-- 6. Declared ON CONFLICT FAIL on NOT NULL — earlier rows remain
-- ===================================
-- With no OR clause the constraint's own action applies, and FAIL keeps the rows
-- written before the violation just as `or fail` does.

create table t_dnn (id integer primary key, x integer not null on conflict fail);

insert into t_dnn values (5, 5), (6, null), (7, 7);
-- error: NOT NULL

select id from t_dnn order by id;
→ [{"id":5}]

-- Inside a transaction the rows stay pending and the transaction stays open.
begin;
insert into t_dnn values (8, 8), (9, null), (10, 10);
-- error: NOT NULL

select id from t_dnn order by id;
→ [{"id":5},{"id":8}]

rollback;

select id from t_dnn order by id;
→ [{"id":5}]

drop table t_dnn;

-- ===================================
-- 7. Declared ON CONFLICT FAIL on CHECK — earlier rows remain
-- ===================================

create table t_dck (id integer primary key, n integer check (n > 0) on conflict fail);

insert into t_dck values (1, 1), (2, -2), (3, 3);
-- error: CHECK

select id from t_dck order by id;
→ [{"id":1}]

drop table t_dck;

-- ===================================
-- 8. Declared ON CONFLICT FAIL on a primary key — earlier rows remain
-- ===================================
-- The module raises this one during the write, so the per-row savepoint is open.

create table t_dpk (id integer primary key on conflict fail, x integer);
insert into t_dpk values (1, 1);
-- run

insert into t_dpk values (5, 5), (1, 5), (6, 6);
-- error: UNIQUE constraint failed

select id from t_dpk order by id;
→ [{"id":1},{"id":5}]

begin;
insert into t_dpk values (7, 7), (1, 7), (8, 8);
-- error: UNIQUE constraint failed

select id from t_dpk order by id;
→ [{"id":1},{"id":5},{"id":7}]

rollback;

drop table t_dpk;

-- ===================================
-- 9. Declared ON CONFLICT FAIL on UNIQUE — earlier rows remain
-- ===================================

create table t_duq (id integer primary key, x integer unique on conflict fail);
insert into t_duq values (1, 1);
-- run

begin;
insert into t_duq values (5, 5), (6, 1), (7, 7);
-- error: UNIQUE constraint failed

select id from t_duq order by id;
→ [{"id":1},{"id":5}]

commit;

select id from t_duq order by id;
→ [{"id":1},{"id":5}]

drop table t_duq;

-- ===================================
-- 10. A table that declares FAIL still undoes the statement for any other action
-- ===================================
-- `x` declares FAIL, but `y` and the primary key resolve to ABORT, so these failures
-- undo the statement's earlier rows. `or abort` overrides the declared action too.

create table t_dmix (
	id integer primary key,
	x integer not null on conflict fail,
	y integer check (y > 0)
);
insert into t_dmix values (0, 0, 1);
-- run

begin;

-- Raised by the source, before the row reaches the module.
insert into t_dmix values (1, 1, 1), (2, 2, -2), (3, 3, 3);
-- error: CHECK

-- Raised by the module during the write.
insert into t_dmix values (1, 1, 1), (0, 2, 2), (3, 3, 3);
-- error: UNIQUE constraint failed

insert or abort into t_dmix values (1, 1, 1), (2, null, 2), (3, 3, 3);
-- error: NOT NULL

select id from t_dmix order by id;
→ [{"id":0}]

commit;

drop table t_dmix;

-- ===================================
-- 11. Declared FAIL on UPDATE — the same rows remain on every module
-- ===================================
-- A module without per-scan snapshot isolation reads every source row before writing
-- any, and the source is what raises NOT NULL and CHECK. The rows before the violation
-- must still be written, and a failure must take effect at its own row's position.

create table t_dup (id integer primary key, x integer not null on conflict fail);
insert into t_dup values (1, 1), (2, 2), (3, 3);
-- run

update t_dup set x = case when id = 2 then null else x + 10 end;
-- error: NOT NULL

select id, x from t_dup order by id;
→ [{"id":1,"x":11},{"id":2,"x":2},{"id":3,"x":3}]

drop table t_dup;

-- Row 2 hits the declared FAIL during its write, and row 3 would hit an ABORT in the
-- source. Row 2 comes first, so row 1 survives.
create table t_dor (
	id integer primary key,
	x integer unique on conflict fail,
	y integer check (y > 0)
);
insert into t_dor values (1, 1, 1), (2, 2, 2), (3, 3, 3);
-- run

update t_dor set
	x = case when id = 3 then 3 else 11 end,
	y = case when id = 3 then -1 else y end;
-- error: UNIQUE constraint failed

select id, x, y from t_dor order by id;
→ [{"id":1,"x":11,"y":1},{"id":2,"x":2,"y":2},{"id":3,"x":3,"y":3}]

drop table t_dor;

-- ===================================
-- 12. Declared FAIL does not let a kept row escape a parent-side RESTRICT
-- ===================================
-- Row 1 moves a key its child still references, then row 2 hits the declared FAIL. The
-- engine batches this RESTRICT check to statement end, and it must still run when the
-- FAIL stops the row loop, or row 1 would survive with its child orphaned. The check's
-- failure is an ABORT, so it undoes the statement.

pragma foreign_keys = true;

create table t_fkp (id integer primary key, n integer check (n > 0) on conflict fail);
create table t_fkc (id integer primary key, pid integer references t_fkp(id));
insert into t_fkp values (1, 1), (2, 2);
insert into t_fkc values (10, 1);
-- run

update t_fkp set id = id + 100, n = case when id = 2 then -1 else n end;
-- error: FOREIGN KEY constraint failed

select id, n from t_fkp order by id;
→ [{"id":1,"n":1},{"id":2,"n":2}]

-- With nothing referencing the moved key, the same statement keeps row 1.
delete from t_fkc;
-- run

update t_fkp set id = id + 100, n = case when id = 2 then -1 else n end;
-- error: CHECK

select id, n from t_fkp order by id;
→ [{"id":2,"n":2},{"id":101,"n":1}]

drop table t_fkc;
drop table t_fkp;

pragma foreign_keys = false;
