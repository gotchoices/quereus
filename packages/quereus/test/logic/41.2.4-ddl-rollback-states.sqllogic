-- Row-validating DDL inside a transaction must hold for every state a rollback could
-- restore. On the bundled backends a schema change survives `rollback` / `rollback to
-- savepoint` (the `non-transactional` tier, docs/module-capabilities.md) while the rows it
-- was judged against do not. So besides the rows the transaction can SEE — which decide
-- whether the statement is LEGAL (CONSTRAINT / MISMATCH) — every state a rollback could
-- return the table to is judged on its own: the committed rows (a whole-transaction
-- rollback) and the rows as they stood at each open savepoint (`rollback to`). When one of
-- them would violate the new rule the statement is refused as retryable (BUSY, "commit the
-- pending writes first"); a released savepoint is not a restorable state, and a deleted row
-- that breaks no rule does not block. Each refusal leaves the table and the transaction
-- untouched, and the same statement lands once the pending writes are committed.
--
-- Cross-backend: under the memory module the restorable states are its own base and
-- savepoint layers; under --store they are the store's committed rows plus the isolation
-- wrapper's overlay savepoint frames, handed down as `IssuerRowSources.savepoints`.
-- See docs/memory-table.md § DDL and transactions, rule 1.

-- ===================================
-- A. `rollback to savepoint` would restore a staged duplicate under the new unique index.
-- ===================================

create table ra (id integer primary key, v text);
insert into ra values (1, 'a');
-- run

begin;
-- run
insert into ra values (2, 'a');
-- run
savepoint s;
-- run
delete from ra where id = 2;
-- run

-- the effective rows and the committed rows are both clean; only the savepoint state holds the pair
create unique index ix_ra on ra (v);
-- error: commit the pending writes first

rollback to savepoint s;
-- run
select id, v from ra order by id;
→ [{"id":1,"v":"a"},{"id":2,"v":"a"}]

rollback;
-- run
select count(*) as c from ra;
→ [{"c":1}]

-- nothing to restore any more: the index lands
create unique index ix_ra on ra (v);
-- run
insert into ra values (3, 'a');
-- error: UNIQUE constraint failed

drop table ra;

-- ===================================
-- B. a committed row the transaction deleted would collide under the new collation.
-- ===================================

create table rb (id integer primary key, v text, unique (v));
insert into rb values (1, 'a'), (2, 'A');
-- run

begin;
-- run
delete from rb where id = 2;
-- run
alter table rb alter column v set collate nocase;
-- error: commit the pending writes first

rollback;
-- run
select name, collation from table_info('rb') where name = 'v';
→ [{"name":"v","collation":"BINARY"}]
select id, v from rb order by id;
→ [{"id":1,"v":"a"},{"id":2,"v":"A"}]

delete from rb where id = 2;
-- run
alter table rb alter column v set collate nocase;
-- run
insert into rb values (3, 'A');
-- error: UNIQUE constraint failed

drop table rb;

-- ===================================
-- C. a committed row the transaction deleted holds a value the new type refuses.
-- ===================================

create table rc (id integer primary key, v text);
insert into rc values (1, 'abc'), (2, '20');
-- run

begin;
-- run
delete from rc where id = 1;
-- run
alter table rc alter column v set data type integer;
-- error: commit the pending writes first

rollback;
-- run
select id, v, typeof(v) from rc order by id;
→ [{"id":1,"v":"abc","typeof(v)":"text"},{"id":2,"v":"20","typeof(v)":"text"}]

delete from rc where id = 1;
-- run
alter table rc alter column v set data type integer;
-- run
select id, v, typeof(v) from rc order by id;
→ [{"id":2,"v":20,"typeof(v)":"integer"}]

drop table rc;

-- ===================================
-- D. a committed NULL the transaction overwrote, with no DEFAULT to fill it from.
-- ===================================

create table rd (id integer primary key, v text null);
insert into rd values (1, null);
-- run

begin;
-- run
update rd set v = 'x' where id = 1;
-- run
alter table rd alter column v set not null;
-- error: commit the pending writes first

rollback;
-- run
select id, v from rd order by id;
→ [{"id":1,"v":null}]
-- still nullable
insert into rd values (2, null);
-- run

delete from rd where id = 2;
-- run
update rd set v = 'x' where id = 1;
-- run
alter table rd alter column v set not null;
-- run
insert into rd values (3, null);
-- error: NOT NULL

drop table rd;

-- ===================================
-- D'. the same shape WITH a DEFAULT: the committed NULL is backfilled, not refused — the
--     rewrite reaches the committed rows, so the restored row satisfies the new rule.
-- ===================================

create table rdd (id integer primary key, v text null default 'filled');
insert into rdd values (1, null);
-- run

begin;
-- run
update rdd set v = 'x' where id = 1;
-- run
alter table rdd alter column v set not null;
-- run
select id, v from rdd order by id;
→ [{"id":1,"v":"x"}]

rollback;
-- run
select id, v from rdd order by id;
→ [{"id":1,"v":"filled"}]
insert into rdd values (2, null);
-- error: NOT NULL

drop table rdd;

-- ===================================
-- E. a pending UPDATE hides a committed duplicate the new unique index would forbid.
-- ===================================

create table re (id integer primary key, v text);
insert into re values (1, 'a'), (2, 'a');
-- run

begin;
-- run
update re set v = 'b' where id = 2;
-- run
create unique index ix_re on re (v);
-- error: commit the pending writes first

commit;
-- run
create unique index ix_re on re (v);
-- run
select id, v from re order by id;
→ [{"id":1,"v":"a"},{"id":2,"v":"b"}]

drop table re;

-- ===================================
-- F. (legal) a deleted row that breaks no rule does not block the build, and the rolled-back
--    table holds no violation.
-- ===================================

create table rf (id integer primary key, v text);
insert into rf values (1, 'a'), (2, 'b');
-- run

begin;
-- run
delete from rf where id = 2;
-- run
create unique index ix_rf on rf (v);
-- run
rollback;
-- run

select id, v from rf order by id;
→ [{"id":1,"v":"a"},{"id":2,"v":"b"}]
insert into rf values (3, 'a');
-- error: UNIQUE constraint failed

drop table rf;

-- ===================================
-- H. (legal) a RELEASED savepoint cannot be rolled back to, so the state it held is not judged.
-- ===================================

create table rh (id integer primary key, v text);
insert into rh values (1, 'a');
-- run

begin;
-- run
insert into rh values (2, 'a');
-- run
savepoint s;
-- run
delete from rh where id = 2;
-- run
release savepoint s;
-- run
create unique index ix_rh on rh (v);
-- run
commit;
-- run

select id, v from rh order by id;
→ [{"id":1,"v":"a"}]
insert into rh values (3, 'a');
-- error: UNIQUE constraint failed

drop table rh;

-- ===================================
-- I. a committed row the transaction deleted would break the new CHECK. Accepted, the CHECK would
--    hide the restored row from every query that filters for it (the optimizer trusts it).
-- ===================================

create table ri (id integer primary key, v integer);
insert into ri values (1, -1), (2, 5);
-- run

begin;
-- run
delete from ri where id = 1;
-- run
alter table ri add constraint pos check (v > 0);
-- error: commit the pending writes first

rollback;
-- run
select id, v from ri where v <= 0;
→ [{"id":1,"v":-1}]

delete from ri where id = 1;
-- run
alter table ri add constraint pos check (v > 0);
-- run
insert into ri values (3, -3);
-- error: CHECK constraint failed

drop table ri;

-- ===================================
-- J. only an open savepoint holds the row that would break the new CHECK.
-- ===================================

create table rj (id integer primary key, v integer);
insert into rj values (1, 1);
-- run

begin;
-- run
insert into rj values (2, -2);
-- run
savepoint s;
-- run
delete from rj where id = 2;
-- run
alter table rj add check (v > 0);
-- error: commit the pending writes first

rollback to savepoint s;
-- run
select id, v from rj where v <= 0;
→ [{"id":2,"v":-2}]

rollback;
-- run
drop table rj;

-- ===================================
-- K. (legal) the savepoint that held the violating row is RELEASED, so the CHECK lands.
-- ===================================

create table rk (id integer primary key, v integer);
insert into rk values (1, 1);
-- run

begin;
-- run
insert into rk values (2, -2);
-- run
savepoint s;
-- run
delete from rk where id = 2;
-- run
release savepoint s;
-- run
alter table rk add check (v > 0);
-- run
commit;
-- run

select id, v from rk order by id;
→ [{"id":1,"v":1}]
insert into rk values (3, -3);
-- error: CHECK constraint failed

drop table rk;

-- ===================================
-- L. a violating row the transaction can see keeps CONSTRAINT, though a committed one also violates.
-- ===================================

create table rl (id integer primary key, v integer);
insert into rl values (1, -1), (2, 5);
-- run

begin;
-- run
delete from rl where id = 2;
-- run
alter table rl add check (v > 0);
-- error: CHECK constraint failed

rollback;
-- run
drop table rl;

-- ===================================
-- M. ADD COLUMN with an inline CHECK: the backfilled DEFAULT lands on a committed row the
--    transaction deleted, which a rollback would restore.
-- ===================================

create table rm (id integer primary key, v integer);
insert into rm values (1, 1);
-- run

begin;
-- run
delete from rm where id = 1;
-- run
alter table rm add column w integer default -1 check (w > 0);
-- error: commit the pending writes first

rollback;
-- run
select * from rm;
→ [{"id":1,"v":1}]

drop table rm;

-- ===================================
-- FOREIGN KEY. A rollback moves child and parent to the same point, so each state of the
-- child is judged against the parent as it would stand at that same point.
-- ===================================

pragma foreign_keys = true;
-- run

-- ===================================
-- N. a committed orphan the transaction deleted would come back under the new foreign key.
-- ===================================

create table np (id integer primary key);
create table nc (id integer primary key, pid integer null);
insert into np values (1);
insert into nc values (1, 99), (2, 1);
-- run

begin;
-- run
delete from nc where id = 1;
-- run
alter table nc add constraint fk_n foreign key (pid) references np (id);
-- error: commit the pending writes first

rollback;
-- run
-- the orphan is back and no constraint claims otherwise
select id, pid from nc where not exists (select 1 from np where np.id = nc.pid) order by id;
→ [{"id":1,"pid":99}]

delete from nc where id = 1;
-- run
alter table nc add constraint fk_n foreign key (pid) references np (id);
-- run
insert into nc values (3, 77);
-- error: CHECK constraint failed: fk_n

drop table nc;
drop table np;

-- ===================================
-- O. a parent the transaction inserted rescues a committed orphan; the child has no open work.
-- ===================================

create table op (id integer primary key);
create table oc (id integer primary key, pid integer null);
insert into oc values (1, 5);
-- run

begin;
-- run
insert into op values (5);
-- run
alter table oc add foreign key (pid) references op (id);
-- error: commit the pending writes first

commit;
-- run
alter table oc add foreign key (pid) references op (id);
-- run
insert into oc values (2, 6);
-- error: CHECK constraint failed: _fk_oc_pid

drop table oc;
drop table op;

-- ===================================
-- P. (legal) a parent deleted together with its child rows: the rollback restores both.
-- ===================================

create table pp (id integer primary key);
create table pc (id integer primary key, pid integer null);
insert into pp values (1), (2);
insert into pc values (1, 1), (2, 2);
-- run

begin;
-- run
delete from pc where pid = 1;
-- run
delete from pp where id = 1;
-- run
alter table pc add constraint fk_p foreign key (pid) references pp (id);
-- run
rollback;
-- run

select id, pid from pc order by id;
→ [{"id":1,"pid":1},{"id":2,"pid":2}]
insert into pc values (3, 9);
-- error: CHECK constraint failed: fk_p

drop table pc;
drop table pp;

-- ===================================
-- Q. only an open savepoint holds the orphan: the child row was staged before it, the parent after.
-- ===================================

create table qp (id integer primary key);
create table qc (id integer primary key, pid integer null);
-- run

begin;
-- run
insert into qc values (1, 7);
-- run
savepoint s;
-- run
insert into qp values (7);
-- run
alter table qc add foreign key (pid) references qp (id);
-- error: commit the pending writes first

rollback to savepoint s;
-- run
select id, pid from qc where not exists (select 1 from qp where qp.id = qc.pid);
→ [{"id":1,"pid":7}]

rollback;
-- run
drop table qc;
drop table qp;

-- ===================================
-- R. (legal) self-referencing: a row deleted with the row that references it. The one table is
--    both sides, so each state is judged against itself.
-- ===================================

create table rs (id integer primary key, up integer null);
insert into rs values (1, null), (2, 1), (3, null);
-- run

begin;
-- run
delete from rs where id in (1, 2);
-- run
alter table rs add constraint fk_up foreign key (up) references rs (id);
-- run
rollback;
-- run

select id, up from rs order by id;
→ [{"id":1,"up":null},{"id":2,"up":1},{"id":3,"up":null}]
insert into rs values (4, 9);
-- error: CHECK constraint failed: fk_up

drop table rs;

-- ===================================
-- S. an orphan the transaction can see keeps CONSTRAINT, though the transaction has open work.
-- ===================================

create table sp (id integer primary key);
create table sc (id integer primary key, pid integer null);
insert into sp values (1);
insert into sc values (1, 99);
-- run

begin;
-- run
insert into sc values (2, 1);
-- run
alter table sc add foreign key (pid) references sp (id);
-- error: FOREIGN KEY constraint failed

rollback;
-- run
drop table sc;
drop table sp;

pragma foreign_keys = false;
-- run
