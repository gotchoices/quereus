-- Mutation Context Tests
-- Tests for table-level mutation context variables used in defaults and constraints
-- Primary use case: application-specific security, rights, signatures, and audit

-- Test 1: Use mutation context in default values
CREATE TABLE products (
	id INTEGER PRIMARY KEY,
	base_price INTEGER,
	final_price INTEGER DEFAULT base_price + markup
) USING memory
WITH CONTEXT (
	markup INTEGER
);

INSERT INTO products (id, base_price)
WITH CONTEXT markup = 50
VALUES (1, 100);

SELECT id, base_price, final_price FROM products
→ [{"id":1,"base_price":100,"final_price":150}]

-- Test 2: Use mutation context in CHECK constraints
CREATE TABLE stock (
	sku TEXT PRIMARY KEY,
	quantity INTEGER,
	CONSTRAINT qty_check CHECK (NEW.quantity >= min_qty)
) USING memory
WITH CONTEXT (
	min_qty INTEGER
);

-- Should succeed with quantity >= min_qty
INSERT INTO stock (sku, quantity)
WITH CONTEXT min_qty = 10
VALUES ('SKU001', 20);

SELECT sku, quantity FROM stock
→ [{"sku":"SKU001","quantity":20}]

-- Should fail with quantity < min_qty
INSERT INTO stock (sku, quantity)
WITH CONTEXT min_qty = 50
VALUES ('SKU002', 30);
-- error: CHECK constraint failed

-- Test 3: Qualified context.varName references
CREATE TABLE items (
	id INTEGER PRIMARY KEY,
	value INTEGER,
	CONSTRAINT value_check CHECK (NEW.value >= context.threshold)
) USING memory
WITH CONTEXT (
	threshold INTEGER
);

INSERT INTO items (id, value)
WITH CONTEXT threshold = 100
VALUES (1, 150);

SELECT id, value FROM items
→ [{"id":1,"value":150}]

-- Test 4: UPDATE with mutation context
CREATE TABLE prices (
	product_id INTEGER PRIMARY KEY,
	price INTEGER,
	CONSTRAINT price_check CHECK (NEW.price >= min_price)
) USING memory
WITH CONTEXT (
	min_price INTEGER
);

INSERT INTO prices
WITH CONTEXT min_price = 0
VALUES (1, 100);

UPDATE prices
WITH CONTEXT min_price = 50
SET price = 75
WHERE product_id = 1;

SELECT price FROM prices WHERE product_id = 1
→ [{"price":75}]

-- Update with invalid context should fail
UPDATE prices
WITH CONTEXT min_price = 100
SET price = 80
WHERE product_id = 1;
-- error: CHECK constraint failed

-- Test 5: DELETE with mutation context
CREATE TABLE audit (
	sku TEXT PRIMARY KEY,
	quantity INTEGER,
	CONSTRAINT delete_check CHECK ON DELETE (allow_delete = 1)
) USING memory
WITH CONTEXT (
	allow_delete INTEGER
);

INSERT INTO audit
WITH CONTEXT allow_delete = 1
VALUES ('A', 10), ('B', 20);

DELETE FROM audit
WITH CONTEXT allow_delete = 1
WHERE sku = 'A';

SELECT sku FROM audit
→ [{"sku":"B"}]

-- Delete with allow_delete = 0 should fail
DELETE FROM audit
WITH CONTEXT allow_delete = 0
WHERE sku = 'B';
-- error: CHECK constraint failed

-- Test 6: Multiple context variables
CREATE TABLE orders (
	id INTEGER PRIMARY KEY,
	amount INTEGER DEFAULT base + tax + shipping
) USING memory
WITH CONTEXT (
	base INTEGER,
	tax INTEGER,
	shipping INTEGER
);

INSERT INTO orders (id)
WITH CONTEXT base = 100, tax = 15, shipping = 5
VALUES (1);

SELECT amount FROM orders WHERE id = 1
→ [{"amount":120}]

-- Test 7: NULL context variables
CREATE TABLE config (
	id INTEGER PRIMARY KEY,
	max_val INTEGER DEFAULT coalesce(limit_val, 999)
) USING memory
WITH CONTEXT (
	limit_val INTEGER NULL
);

INSERT INTO config (id)
WITH CONTEXT limit_val = NULL
VALUES (1);

SELECT max_val FROM config WHERE id = 1
→ [{"max_val":999}]

-- Test 8: RETURNING with mutation context
CREATE TABLE computed (
	id INTEGER PRIMARY KEY,
	result INTEGER DEFAULT base * multiplier
) USING memory
WITH CONTEXT (
	base INTEGER,
	multiplier INTEGER
);

INSERT INTO computed (id)
WITH CONTEXT base = 10, multiplier = 5
VALUES (1)
RETURNING id, result
→ [{"id":1,"result":50}]

-- Test 9: Context variable shadowing column names
CREATE TABLE shadowing (
	id INTEGER PRIMARY KEY,
	value TEXT NULL,
	label TEXT DEFAULT value
) USING memory
WITH CONTEXT (
	value TEXT
);

INSERT INTO shadowing (id)
WITH CONTEXT value = 'from_context'
VALUES (1);

SELECT label FROM shadowing WHERE id = 1
→ [{"label":"from_context"}]

-- Test 10: Deferred constraints with mutation context
CREATE TABLE deferred_test (
	id INTEGER PRIMARY KEY,
	stock INTEGER,
	CONSTRAINT stock_check CHECK (
		NEW.stock >= min_stock OR
		EXISTS (SELECT 1 FROM deferred_test WHERE id = NEW.id AND stock > 0)
	)
) USING memory
WITH CONTEXT (
	min_stock INTEGER
);

BEGIN;

INSERT INTO deferred_test (id, stock)
WITH CONTEXT min_stock = 10
VALUES (1, 15);

COMMIT;

SELECT stock FROM deferred_test WHERE id = 1
→ [{"stock":15}]

-- Test 11: new.<column> reads a supplied sibling alongside a context variable
CREATE TABLE invoice (
	id INTEGER PRIMARY KEY,
	subtotal INTEGER,
	total INTEGER DEFAULT (new.subtotal + tax)
) USING memory
WITH CONTEXT (
	tax INTEGER
);

INSERT INTO invoice (id, subtotal)
WITH CONTEXT tax = 7
VALUES (1, 100);

SELECT total FROM invoice WHERE id = 1
→ [{"total":107}]

-- Test 12: bare-vs-new precedence when the colliding column IS supplied.
-- A context variable and a column share the name `amount`. When `amount` is
-- supplied by the INSERT, a bare `amount` reference still resolves to the
-- context variable (context shadows the column), while `new.amount` resolves to
-- the supplied column value. No "symbol already exists" collision is raised.
CREATE TABLE collide (
	id INTEGER PRIMARY KEY,
	amount INTEGER NULL,
	bare_label INTEGER DEFAULT amount,
	qual_label INTEGER DEFAULT (new.amount)
) USING memory
WITH CONTEXT (
	amount INTEGER
);

INSERT INTO collide (id, amount)
WITH CONTEXT amount = 999
VALUES (1, 100);

SELECT bare_label, qual_label FROM collide WHERE id = 1
→ [{"bare_label":999,"qual_label":100}]

-- Test 13: ALTER COLUMN SET DEFAULT coexists with a context variable. The default
-- is installed via ALTER (not CREATE) yet resolves `new.<col>` (a supplied sibling)
-- alongside a context variable at INSERT time — mirroring Test 11.
CREATE TABLE invoice_alt (
	id INTEGER PRIMARY KEY,
	subtotal INTEGER,
	total INTEGER
) USING memory
WITH CONTEXT (
	tax INTEGER
);

ALTER TABLE invoice_alt ALTER COLUMN total SET DEFAULT (new.subtotal + tax);

INSERT INTO invoice_alt (id, subtotal)
WITH CONTEXT tax = 7
VALUES (1, 100);

SELECT total FROM invoice_alt WHERE id = 1
→ [{"total":107}]

-- Test 14: through the shared-surrogate envelope — a member-table column default
-- reads a supplied sibling via `new.<col>` alongside a per-statement context
-- variable. The shared key is minted once from the anchor's allocator default; the
-- member's `total` default combines `new.amount` (supplied) with `tax` (context).
CREATE TABLE ec_core (
	rid INTEGER PRIMARY KEY DEFAULT (coalesce((SELECT max(rid) FROM ec_core), 0) + mutation_ordinal()),
	name TEXT
) USING memory;
CREATE TABLE ec_line (
	rid INTEGER PRIMARY KEY,
	amount INTEGER,
	total INTEGER DEFAULT (new.amount + tax)
) USING memory
WITH CONTEXT (
	tax INTEGER
);
CREATE VIEW ec_v AS SELECT c.name AS name, l.amount AS amount
	FROM ec_core c JOIN ec_line l ON l.rid = c.rid;

INSERT INTO ec_v WITH CONTEXT tax = 5 VALUES ('Ada', 100), ('Lin', 200);

SELECT rid, amount, total FROM ec_line ORDER BY rid
→ [{"rid":1,"amount":100,"total":105},{"rid":2,"amount":200,"total":205}]

-- Test 15: a subquery as a WITH CONTEXT value (optimizer must see it as a child).
-- `DmlExecutorNode` and `ConstraintCheckNode` both expose their mutation-context
-- value expressions as getChildren() so a subquery there gets rewritten like any
-- other plan node. See bug-dml-side-expressions-invisible-to-optimizer.

CREATE TABLE ctx_src (id INTEGER PRIMARY KEY, v TEXT);
INSERT INTO ctx_src VALUES (1, 'a'), (2, 'b'), (3, 'c');

-- Each op's context value feeds a CHECK constraint, mirroring Tests 2/4/5 above
-- but with a subquery in place of a literal — proving the rewritten value reaches
-- `ConstraintCheckNode` (not just the DML executor) for INSERT, UPDATE and DELETE.

CREATE TABLE ctx_insert (
	id INTEGER PRIMARY KEY,
	CONSTRAINT gate_check CHECK (NEW.id <= who)
) USING memory
WITH CONTEXT (
	who INTEGER
);

-- passes: subquery count is 3, id is 1
INSERT INTO ctx_insert (id)
WITH CONTEXT who = (SELECT COUNT(*) FROM ctx_src)
VALUES (1);

SELECT id FROM ctx_insert
→ [{"id":1}]

-- fails: subquery count is 1, id is 2
INSERT INTO ctx_insert (id)
WITH CONTEXT who = (SELECT COUNT(*) FROM ctx_src WHERE id = 1)
VALUES (2);
-- error: CHECK constraint failed

DROP TABLE ctx_insert;

CREATE TABLE ctx_update (
	id INTEGER PRIMARY KEY,
	val INTEGER,
	CONSTRAINT gate_check CHECK (NEW.val <= who)
) USING memory
WITH CONTEXT (
	who INTEGER
);

INSERT INTO ctx_update WITH CONTEXT who = 999 VALUES (1, 0);

-- passes: subquery count is 3, val is 2
UPDATE ctx_update
WITH CONTEXT who = (SELECT COUNT(*) FROM ctx_src)
SET val = 2
WHERE id = 1;

SELECT val FROM ctx_update WHERE id = 1
→ [{"val":2}]

-- fails: subquery count is 1, val is 2
UPDATE ctx_update
WITH CONTEXT who = (SELECT COUNT(*) FROM ctx_src WHERE id = 1)
SET val = 2
WHERE id = 1;
-- error: CHECK constraint failed

DROP TABLE ctx_update;

CREATE TABLE ctx_delete (
	id INTEGER PRIMARY KEY,
	CONSTRAINT delete_check CHECK ON DELETE (who >= 3)
) USING memory
WITH CONTEXT (
	who INTEGER
);

INSERT INTO ctx_delete WITH CONTEXT who = 999 VALUES (1), (2);

-- fails: subquery count is 1
DELETE FROM ctx_delete
WITH CONTEXT who = (SELECT COUNT(*) FROM ctx_src WHERE id = 1)
WHERE id = 1;
-- error: CHECK constraint failed

-- passes: subquery count is 3
DELETE FROM ctx_delete
WITH CONTEXT who = (SELECT COUNT(*) FROM ctx_src)
WHERE id = 1;

SELECT id FROM ctx_delete
→ [{"id":2}]

DROP TABLE ctx_delete;
DROP TABLE ctx_src;

-- Test 16: omitting the envelope on a table whose CHECK reads a NOT NULL context
-- variable reports the missing STATEMENT argument, naming both table and variable —
-- not "context.<var> isn't a column", which pointed the reader at the schema.
CREATE TABLE revocation (
	stamp_id TEXT PRIMARY KEY,
	reissued_at INTEGER NULL,
	CONSTRAINT authorized_reissue CHECK (context.owner_key = 'k')
) USING memory
WITH CONTEXT (
	owner_key TEXT,
	signature TEXT NULL
);

INSERT INTO revocation (stamp_id) VALUES ('a');
-- error: table 'main.revocation' requires mutation context variable 'owner_key'

-- Test 17: supplying an envelope that omits one NOT NULL variable is the same
-- diagnosis, not an internal error.
INSERT INTO revocation (stamp_id) WITH CONTEXT signature = 'x' VALUES ('a');
-- error: table 'main.revocation' requires mutation context variable 'owner_key'

UPDATE revocation WITH CONTEXT signature = 'x' SET reissued_at = 1;
-- error: table 'main.revocation' requires mutation context variable 'owner_key'

-- The NULL-marked `signature` may be omitted entirely.
INSERT INTO revocation (stamp_id) WITH CONTEXT owner_key = 'k' VALUES ('a');

SELECT stamp_id, reissued_at FROM revocation
→ [{"stamp_id":"a","reissued_at":null}]

-- Test 18: a name the table does not declare is ignored, not rejected. View
-- decomposition forwards one envelope verbatim to every member statement, so a member
-- routinely receives values for variables it never declared.
INSERT INTO revocation (stamp_id) WITH CONTEXT owner_key = 'k', bogus = 1 VALUES ('b');

SELECT stamp_id FROM revocation ORDER BY stamp_id
→ [{"stamp_id":"a"},{"stamp_id":"b"}]

-- Test 19: an omitted NULL-marked variable reads as NULL rather than erroring, so a
-- CHECK comparing against it behaves like any NULL comparison (unknown ⇒ passes),
-- and one written to reject NULL fails as a CHECK — never as a missing argument.
CREATE TABLE floor_guard (
	id INTEGER PRIMARY KEY,
	v INTEGER NULL,
	CONSTRAINT unknown_passes CHECK (v >= floor_v)
) USING memory
WITH CONTEXT (
	floor_v INTEGER NULL
);

INSERT INTO floor_guard (id, v) VALUES (1, 5);

SELECT id, v FROM floor_guard
→ [{"id":1,"v":5}]

CREATE TABLE floor_strict (
	id INTEGER PRIMARY KEY,
	v INTEGER NULL,
	CONSTRAINT null_rejected CHECK (coalesce(v >= floor_v, 0))
) USING memory
WITH CONTEXT (
	floor_v INTEGER NULL
);

INSERT INTO floor_strict (id, v) VALUES (1, 5);
-- error: CHECK constraint failed

INSERT INTO floor_strict (id, v) WITH CONTEXT floor_v = 1 VALUES (1, 5);

SELECT id, v FROM floor_strict
→ [{"id":1,"v":5}]

-- Test 20: a declared variable that no default or constraint reads never makes the
-- envelope mandatory — the error is raised where the variable is REFERENCED, not
-- where the symbols are registered. Regression guard for envelope-less writes.
CREATE TABLE unread_ctx (
	id INTEGER PRIMARY KEY
) USING memory
WITH CONTEXT (
	never_read TEXT
);

INSERT INTO unread_ctx VALUES (1);

SELECT id FROM unread_ctx
→ [{"id":1}]

-- Likewise for an op the constraint does not cover: `revocation`'s CHECK is
-- INSERT/UPDATE-scoped, so a DELETE reads no context variable and needs no envelope.
DELETE FROM revocation WHERE stamp_id = 'b';

SELECT stamp_id FROM revocation
→ [{"stamp_id":"a"}]

-- Test 21: a write mediated by a view reports the MEMBER table that declares the
-- variable, not the view the statement named.
CREATE TABLE mv_core (
	rid INTEGER PRIMARY KEY DEFAULT (coalesce((SELECT max(rid) FROM mv_core), 0) + mutation_ordinal()),
	name TEXT
) USING memory;
CREATE TABLE mv_line (
	rid INTEGER PRIMARY KEY,
	amount INTEGER,
	CONSTRAINT cap_check CHECK (amount <= cap)
) USING memory
WITH CONTEXT (
	cap INTEGER
);
CREATE VIEW mv_v AS SELECT c.name AS name, l.amount AS amount
	FROM mv_core c JOIN mv_line l ON l.rid = c.rid;

INSERT INTO mv_v VALUES ('Ada', 10);
-- error: table 'main.mv_line' requires mutation context variable 'cap'

INSERT INTO mv_v WITH CONTEXT cap = 100 VALUES ('Lin', 10);

SELECT rid, amount FROM mv_line
→ [{"rid":1,"amount":10}]

-- Test 22: BEHAVIOR CHANGE — context variables are now registered for a write that
-- supplies no envelope, so a bare reference that collides with a column name resolves
-- to the (unsupplied, hence NULL) context variable, where it used to resolve to the
-- column. Precedence is the documented one; only the envelope-less case moved.
CREATE TABLE shadow_null (
	id INTEGER PRIMARY KEY,
	value TEXT NULL,
	bare_label TEXT NULL DEFAULT value,
	qual_label TEXT NULL DEFAULT (new.value)
) USING memory
WITH CONTEXT (
	value TEXT NULL
);

INSERT INTO shadow_null (id, value) VALUES (1, 'col');
INSERT INTO shadow_null (id, value) WITH CONTEXT value = 'ctx' VALUES (2, 'col');

SELECT id, bare_label, qual_label FROM shadow_null ORDER BY id
→ [{"id":1,"bare_label":null,"qual_label":"col"},{"id":2,"bare_label":"ctx","qual_label":"col"}]

-- Test 23: a deferred CHECK captures context at write time and evaluates at COMMIT;
-- an omitted NULL-marked variable must survive that capture AS NULL, not vanish (which
-- would misalign the captured context row against its descriptor).
CREATE TABLE deferred_null_ctx (
	id INTEGER PRIMARY KEY,
	stock INTEGER,
	CONSTRAINT stock_check CHECK (
		coalesce(stock >= min_stock, 1) AND
		EXISTS (SELECT 1 FROM deferred_null_ctx WHERE id = NEW.id)
	)
) USING memory
WITH CONTEXT (
	min_stock INTEGER NULL
);

BEGIN;

INSERT INTO deferred_null_ctx (id, stock) VALUES (1, 15);

COMMIT;

SELECT stock FROM deferred_null_ctx WHERE id = 1
→ [{"stock":15}]

-- The same deferred constraint still sees a supplied value.
BEGIN;

INSERT INTO deferred_null_ctx (id, stock) WITH CONTEXT min_stock = 99 VALUES (2, 15);

COMMIT;
-- error: CHECK constraint failed

-- Test 24: a NOT NULL column whose DEFAULT reads an omitted NULL-marked variable
-- yields NULL and then hits the ordinary NOT NULL column check — not a context error.
CREATE TABLE stamped (
	id INTEGER PRIMARY KEY,
	who TEXT NOT NULL DEFAULT stamp
) USING memory
WITH CONTEXT (
	stamp TEXT NULL
);

INSERT INTO stamped (id) VALUES (1);
-- error: NOT NULL constraint failed: stamped.who

INSERT INTO stamped (id) WITH CONTEXT stamp = 'me' VALUES (2);

SELECT id, who FROM stamped
→ [{"id":2,"who":"me"}]

-- Test 25: the UPSERT `do update` arm re-plans the table's UPDATE-scoped constraints,
-- so the same rules hold there.
CREATE TABLE upsert_ctx (
	id INTEGER PRIMARY KEY,
	v INTEGER,
	CONSTRAINT cap_check CHECK (v <= cap)
) USING memory
WITH CONTEXT (
	cap INTEGER
);

INSERT INTO upsert_ctx WITH CONTEXT cap = 100 VALUES (1, 1);

INSERT INTO upsert_ctx VALUES (1, 2) ON CONFLICT (id) DO UPDATE SET v = 2;
-- error: table 'main.upsert_ctx' requires mutation context variable 'cap'

INSERT INTO upsert_ctx WITH CONTEXT cap = 100 VALUES (1, 2) ON CONFLICT (id) DO UPDATE SET v = 2;

SELECT id, v FROM upsert_ctx
→ [{"id":1,"v":2}]

-- Test 26: ADD COLUMN supplies no envelope. Its DEFAULT backfill reads a NULL-declared
-- variable as NULL, while later writes read the supplied value from the same DEFAULT.
create table AcCtx (a integer primary key) with context (who integer null);
insert into AcCtx values (1);
alter table AcCtx add column c integer null default (who);
insert into AcCtx (a) with context who = 7 values (2);
select a, c from AcCtx order by a
→ [{"a":1,"c":null},{"a":2,"c":7}]

-- A NOT NULL variable read by the DEFAULT is rejected even with no rows to backfill.
create table AcCtxReq (a integer primary key) with context (who integer);
alter table AcCtxReq add column c integer null default (who);
-- error: ALTER TABLE supplies no context

-- Test 27: a CHECK reading a context variable constrains a per-statement value, so the
-- optimizer may draw no column fact from it. A row that contradicts the column reading
-- of `who > 0` is legal here and must not be folded out of a query.
create table FactBare (a integer primary key, who integer null, check (who > 0)) with context (who integer null);
insert into FactBare values (1, -1);
select * from FactBare where who <= 0
→ [{"a":1,"who":-1}]

create table FactQual (a integer primary key, who integer null, check (context.who > 0)) with context (who integer null);
insert into FactQual values (1, -1);
select * from FactQual where who <= 0
→ [{"a":1,"who":-1}]

-- A self-qualified name is enforced against the column, but rows stored while it read the
-- variable were never judged against the column, so no fact is drawn from it either.
create table FactSelf (a integer primary key, who integer null, check (FactSelf.who > 0)) with context (who integer null);
insert into FactSelf values (1, -1);
-- error: CHECK constraint failed
select op from query_plan('select * from FactSelf where who <= 0') where op = 'EMPTYRELATION'
→ []

-- A variable sharing no column's name is screened too: `b` does not determine `a` when
-- the rest of the sum varies per statement, so these two rows stay two groups.
create table FactFree (id integer primary key, a integer, b integer, check (a = b + who)) with context (who integer null);
insert into FactFree with context who = 1 values (1, 2, 1);
insert into FactFree with context who = 2 values (2, 3, 1);
select b, a, count(*) as c from FactFree group by b, a order by a
→ [{"b":1,"a":2,"c":1},{"b":1,"a":3,"c":1}]

-- The screen sees a read anywhere in the conjunct, including inside a CASE arm.
create table FactCase (id integer primary key, a integer, b integer, check (a = case when who > 0 then b else b + 1 end)) with context (who integer null);
insert into FactCase with context who = 1 values (1, 1, 1);
insert into FactCase with context who = -1 values (2, 2, 1);
select b, a, count(*) as c from FactCase group by b, a order by a
→ [{"b":1,"a":1,"c":1},{"b":1,"a":2,"c":1}]

-- The screen is per conjunct and per spelling: `new.who` reaches the column and `b > 0`
-- reads no variable, so both still lift beside a conjunct that reads the variable.
create table FactKept (a integer primary key, who integer null, b integer null, check (who > 0 and new.who > 0 and b > 0)) with context (who integer null);
select op from query_plan('select * from FactKept where who <= 0') where op = 'EMPTYRELATION'
→ [{"op":"EMPTYRELATION"}]
select op from query_plan('select * from FactKept where b <= 0') where op = 'EMPTYRELATION'
→ [{"op":"EMPTYRELATION"}]

-- Test 28: existing-row validation of a CHECK added by ALTER runs as a statement with no
-- envelope. A NULL-declared variable reads NULL, so a comparison against it is unknown and
-- the row passes, on ADD CONSTRAINT and on both ADD COLUMN paths.
create table AvNull (a integer primary key, b integer null) with context (who integer null);
create table AvLookup (k integer primary key);
create table AvOwn (k integer primary key, who integer null);
insert into AvNull values (1, 5);
insert into AvOwn values (1, 5);
alter table AvNull add constraint k1 check (who is null or a > 0);
alter table AvNull add constraint k2 check (context.who > 0);
alter table AvNull add constraint k3 check (who is null or exists (select 1 from AvLookup where k = who));
alter table AvNull add column c1 integer null default 1 check (who is null or c1 > 0);
alter table AvNull add column c2 integer null default (new.b) check (who is null or c2 > 0);
select a, b, c1, c2 from AvNull
→ [{"a":1,"b":5,"c1":1,"c2":5}]

-- A subquery source with its own column of that name keeps it.
alter table AvNull add constraint k4 check (exists (select 1 from AvOwn where who = 5));
alter table AvNull add constraint k5 check (exists (select 1 from AvOwn where who = 6));
-- error: existing rows in 'AvNull' violate

-- The part of the CHECK that reads no variable is still judged.
create table AvNeg (a integer primary key) with context (who integer null);
insert into AvNeg values (-1);
alter table AvNeg add constraint k check (who is not null or a > 0);
-- error: existing rows in 'AvNeg' violate
alter table AvNeg add column c integer null default (new.a) check (who is not null or c > 0);
-- error: CHECK constraint failed

-- The accepted CHECK is enforced by a later write that supplies the variable.
create table AvLater (a integer primary key) with context (who integer null);
alter table AvLater add constraint k check (context.who > 0);
insert into AvLater with context who = 0 values (1);
-- error: CHECK constraint failed
insert into AvLater with context who = 1 values (1);
select a from AvLater
→ [{"a":1}]

-- A bare name shared by a column and a variable reads the variable, as on a write, so the
-- column holding -1 violates nothing. `new.<name>` reaches the column.
create table AvShadow (a integer primary key, who integer null) with context (who integer null);
insert into AvShadow values (1, -1);
alter table AvShadow add constraint k1 check (who > 0);
alter table AvShadow add column c integer null default 1 check (who > 0);
alter table AvShadow add column d integer null default (new.who) check (who > 0);
select a, who, c, d from AvShadow
→ [{"a":1,"who":-1,"c":1,"d":-1}]
alter table AvShadow add constraint k2 check (new.who > 0);
-- error: existing rows in 'AvShadow' violate
alter table AvShadow add column e integer null default 1 check (new.who > 0);
-- error: violated by backfilled rows
alter table AvShadow add column e integer null default (new.who) check (new.who > 0);
-- error: CHECK constraint failed

-- A self-qualified name reaches the column, as on a write, including inside a subquery, where
-- it finds -1 in AvLookup. Other self-qualified names reach their columns too.
insert into AvLookup values (-1);
alter table AvShadow add constraint k3 check (AvShadow.who > 0);
-- error: existing rows in 'AvShadow' violate
alter table AvShadow add constraint k4 check (not exists (select 1 from AvLookup where k = AvShadow.who));
-- error: existing rows in 'AvShadow' violate
alter table AvShadow add constraint k5 check (AvShadow.c > 1);
-- error: existing rows in 'AvShadow' violate

-- On a table literally named `context`, `context.<name>` of a variable is still the variable.
create table context (a integer primary key, who integer null) with context (who integer null);
insert into context values (1, -1);
alter table context add constraint k1 check (context.who > 0);
alter table context add constraint k2 check (context.a > 1);
-- error: existing rows in 'context' violate
-- Three parts name the table, so this reaches the column.
alter table context add constraint k3 check (main.context.who > 0);
-- error: existing rows in 'context' violate

-- A NOT NULL variable the CHECK does not read does not stop ALTER judging the column.
create table AvSelfReq (a integer primary key, who integer null) with context (who integer);
insert into AvSelfReq values (1, -1);
alter table AvSelfReq add constraint k check (AvSelfReq.who > 0);
-- error: existing rows in 'AvSelfReq' violate
alter table AvSelfReq add constraint k check (AvSelfReq.who < 0);

-- On a table named `new`, both spellings reach the column, and a name that is only a variable
-- reads the variable, which is NULL here, so the row passes.
create table "new" (a integer primary key, who integer null) with context (who integer null, ghost integer null);
insert into "new" values (1, -1);
alter table "new" add constraint k1 check ("new".who > 0);
-- error: existing rows in 'new' violate
alter table "new" add constraint k2 check (main."new".who > 0);
-- error: existing rows in 'new' violate
alter table "new" add constraint k3 check (new.ghost > 0);
drop table "new";

-- The internal name a shadowed column is scanned under stays clear of a real column using it.
create table AvCollide (a integer primary key, "__quereus_shadowed_who" integer null, who integer null) with context (who integer null);
insert into AvCollide values (1, 5, -1);
alter table AvCollide add constraint k1 check ("__quereus_shadowed_who" > 0);
alter table AvCollide add constraint k2 check (new.who > 0);
-- error: existing rows in 'AvCollide' violate

-- A column added under a variable's name is shadowed the same way, on both ADD COLUMN paths.
create table AvNewLit (a integer primary key) with context (who integer null);
insert into AvNewLit values (1);
alter table AvNewLit add column who integer null default -1 check (who > 0);
select a, who from AvNewLit
→ [{"a":1,"who":-1}]
create table AvNewRow (a integer primary key, b integer null) with context (who integer null);
insert into AvNewRow values (1, -1);
alter table AvNewRow add column who integer null default (new.b) check (who > 0);
select a, b, who from AvNewRow
→ [{"a":1,"b":-1,"who":-1}]

-- A CHECK that reads a NOT NULL variable is rejected whether or not the table has rows,
-- because ALTER cannot supply a value, and the table is left as it was.
create table AvReq (a integer primary key, b integer null) with context (who integer);
alter table AvReq add constraint k check (who > 0);
-- error: ALTER TABLE supplies no context to validate existing rows
insert into AvReq values (1, 5);
alter table AvReq add constraint k check (who > 0);
-- error: ALTER TABLE supplies no context to validate existing rows
alter table AvReq add column c integer null default 1 check (who > 0);
-- error: ALTER TABLE supplies no context to validate existing rows
alter table AvReq add column c integer null default (new.b) check (who > 0);
-- error: ALTER TABLE supplies no context to validate existing rows
alter table AvReq add constraint k check (old.a > 0 and who > 0);
-- error: ALTER TABLE supplies no context to validate existing rows
insert into AvReq values (2, 6);
select * from AvReq order by a
→ [{"a":1,"b":5},{"a":2,"b":6}]

-- A CHECK the validation does not judge owes stored rows nothing, so it stays accepted even
-- over a NOT NULL variable: a partial operation mask on every path, and a conjunct with `old.`.
alter table AvReq add constraint k_upd check on update (who > 0);
alter table AvReq add column c integer null default 1 check on update (who > 0);
alter table AvReq add column d integer null default (new.b) check on update (who > 0);
alter table AvReq add constraint k_old check (old.a is null or who > 0);
update AvReq set b = 7 where a = 1;
-- error: table 'main.AvReq' requires mutation context variable 'who'
update AvReq with context who = 1 set b = 7 where a = 1;
select a, b, c, d from AvReq where a = 1
→ [{"a":1,"b":7,"c":1,"d":5}]

-- The per-row path judges no partial-mask CHECK, the same as the literal-default path.
create table AvMask (a integer primary key, b integer null);
insert into AvMask values (1, 5);
alter table AvMask add column c integer null default (new.b) check on update (c > 100);
select a, b, c from AvMask
→ [{"a":1,"b":5,"c":5}]

-- Test 29: a CHECK that names a shadowed column through its table tests the column, whatever
-- the variable holds, and judges the row image the operation judges.
create table SqPair (a integer primary key, who integer null, check (SqPair.who > 0)) with context (who integer null);
insert into SqPair with context who = 5 values (1, -1);
-- error: CHECK constraint failed
insert into SqPair with context who = -5 values (2, 5);
update SqPair with context who = 5 set who = -1;
-- error: CHECK constraint failed
update SqPair with context who = -5 set who = 6;
select a, who from SqPair
→ [{"a":2,"who":6}]

create table SqSchema (a integer primary key, who integer null, check (main.SqSchema.who > 0)) with context (who integer null);
insert into SqSchema with context who = 5 values (1, -1);
-- error: CHECK constraint failed
insert into SqSchema with context who = -5 values (2, 5);
select a, who from SqSchema
→ [{"a":2,"who":5}]

create table SqDelete (a integer primary key, who integer null, check on delete (SqDelete.who > 0)) with context (who integer null);
insert into SqDelete values (1, -1), (2, 3);
delete from SqDelete with context who = 5 where a = 1;
-- error: CHECK constraint failed
delete from SqDelete with context who = -5 where a = 2;
select a, who from SqDelete
→ [{"a":1,"who":-1}]

-- The variable is not read, so a NOT NULL one need not be supplied.
create table SqReq (a integer primary key, who integer null, check (SqReq.who > 0)) with context (who integer);
insert into SqReq values (1, 5);
insert into SqReq values (2, -5);
-- error: CHECK constraint failed
select a, who from SqReq
→ [{"a":1,"who":5}]

-- A table literally named `new`: the row that would otherwise be lost to a query is refused.
create table "new" (a integer primary key, who integer null, check (new.who > 0)) with context (who integer null);
insert into "new" values (1, -1);
-- error: CHECK constraint failed
drop table "new";

-- On the table named `context` from Test 28, whose `k1` is `context.who > 0`, two parts read the
-- variable and three parts the column.
insert into context with context who = -5 values (2, 5);
-- error: CHECK constraint failed
alter table context add constraint k4 check (main.context.who > -2);
insert into context with context who = 5 values (2, -3);
-- error: CHECK constraint failed
insert into context with context who = 5 values (2, -1);
select a, who from context order by a
→ [{"a":1,"who":-1},{"a":2,"who":-1}]

-- Inside a subquery the name stays the outer row's column, even where the subquery's own source
-- has a column of that name, or is itself named `new`.
create table SqPeer (k integer primary key, who integer null);
insert into SqPeer values (1, 7);
create table SqSub (a integer primary key, who integer null, check (exists (select 1 from SqPeer where SqPeer.who = SqSub.who))) with context (who integer null);
insert into SqSub with context who = 7 values (1, 8);
-- error: CHECK constraint failed
insert into SqSub with context who = 8 values (2, 7);
select a, who from SqSub
→ [{"a":2,"who":7}]

create table "new" (k integer primary key, who integer null);
insert into "new" values (1, 7);
create table SqNew (a integer primary key, who integer null, check (exists (select 1 from "new" where "new".who = SqNew.who))) with context (who integer null);
insert into SqNew with context who = 7 values (1, 8);
-- error: CHECK constraint failed
insert into SqNew with context who = 8 values (2, 7);
select a, who from SqNew
→ [{"a":2,"who":7}]
drop table SqNew;
drop table "new";

-- A CTE body cannot correlate to the written row, so the name stays unresolved there, as an
-- unshadowed name does, rather than judging every row on the first row's value.
create table SqCte (a integer primary key, who integer null, check ((with c as (select SqCte.who as x from SqPeer) select max(x) from c) > 0)) with context (who integer null);
insert into SqCte values (1, 5), (2, -5);
-- error: SqCte.who isn't a column
