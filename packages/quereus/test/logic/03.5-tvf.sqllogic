-- test/logic/tvf.sqllogic

-- Check query plan using the new TVF
-- After relational constant folding, SELECT 1+1 collapses to Block → TableLiteral
SELECT op FROM query_plan('SELECT 1 + 1');
→ [{"op":"BLOCK"},{"op":"TABLELITERAL"}]

-- Check scheduler program dump TVF (basic execution check)
-- After relational constant folding, SELECT 1 collapses to Block → TableLiteral
SELECT description FROM scheduler_program('SELECT 1');
→ [{"description":"tableLiteral(1 rows, 1 cols)"},{"description":"block(1 stmts, result idx: 0)"}]

-- json_each: array immediate children only
SELECT key, value FROM json_each('[10, 20, {"a": 30}]');
→ [{"key":0,"value":10},{"key":1,"value":20},{"key":2,"value":"{\"a\":30}"}]

-- json_each: object immediate children only (does NOT recurse into nested containers)
SELECT key, value, type FROM json_each('{"a":{"b":1},"c":2}');
→ [{"key":"a","value":"{\"b\":1}","type":"object"},{"key":"c","value":2,"type":"integer"}]

-- Basic json_tree (just test it runs for now)
SELECT id, fullkey, type, atom FROM json_tree('{"a": [1, 2], "b": true}');

-- TVF with alias and WHERE filter
SELECT j.key FROM json_each('[5,6]') AS j WHERE j.value > 5;
→ [{"key":1}]

-- TVF with alias and qualified SELECT *
SELECT j.* FROM json_each('[5,6]') AS j WHERE j.value > 5;
→ [{"key":1,"value":6,"type":"integer","atom":6,"id":1,"parent":null,"fullkey":"[1]","path":""}]

-- json_each with root path
SELECT key, value FROM json_each('{"data": [1, 2]}', '$.data');
→ [{"key":0,"value":1},{"key":1,"value":2}]

-- TVF with root path (json_tree) (just test it runs for now)
SELECT fullkey, value FROM json_tree('{"a": 1, "nested": {"b": 2}}', '$.nested');

-- expect error: Invalid JSON
SELECT * FROM json_each('invalid json');
-- error: Error: Invalid JSON provided to json_each

-- expect error: Function not found
SELECT * FROM non_existent_tvf(1);
-- error: Function not found: non_existent_tvf/1

-- expect error: Incorrect number of arguments (json_each - no args)
SELECT * FROM json_each();
-- error: Error: json_each requires 1 or 2 arguments (jsonSource, [rootPath])

-- expect error: Incorrect number of arguments (json_each - too many args)
SELECT * FROM json_each('[]', '$', 'extra');
-- error: Error: json_each requires 1 or 2 arguments (jsonSource, [rootPath])

-- expect error: Incorrect number of arguments (json_tree - no args)
SELECT * FROM json_tree();
-- error: Error: json_tree requires 1 or 2 arguments (jsonSource, [rootPath])

-- expect error: Incorrect number of arguments (json_tree - too many args)
SELECT * FROM json_tree('{}', '$', 'extra');
-- error: Error: json_tree requires 1 or 2 arguments (jsonSource, [rootPath])

-- generate_series yields exactly the integers n with start <= n <= stop: its column is
-- a declared INTEGER key, so a fractional bound rounds inward, never out of the range.
select value from generate_series(0.5, 3);
→ [{"value":1},{"value":2},{"value":3}]

select value from generate_series(-2.5, -0.5);
→ [{"value":-2},{"value":-1}]

select value from generate_series(1, 3.5);
→ [{"value":1},{"value":2},{"value":3}]

-- Rounding -0.5 up lands on 0, not -0 (the harness's deep equality tells them apart)
select value from generate_series(-0.5, 0.5);
→ [{"value":0}]

-- A bound with no integer reading gives no rows, on either side
select value from generate_series(null, 3);
→ []

select value from generate_series(-2, null);
→ []

select value from generate_series(1, null);
→ []

select value from generate_series(1, 1e400);
→ []

select value from generate_series(-1e400, 1);
→ []

select value from generate_series('', 1);
→ []

-- Text bounds read as the number they spell; text that spells none is an error
select value from generate_series('2', '3.5');
→ [{"value":2},{"value":3}]

select value from generate_series('abc', 4);
-- error: Cannot convert 'abc' to NUMERIC

select value from generate_series(x'00', 4);
-- error: Cannot convert object to NUMERIC

-- Past 2^53 the values stay exact. Compared as text because the harness rounds a bigint
-- through Number() before comparing. The limit sits above the expected row count so that
-- a counter that stops advancing returns repeated values and fails, instead of hanging.
select cast(value as text) as v from generate_series(9007199254740990, 9007199254740993) limit 6;
→ [{"v":"9007199254740990"},{"v":"9007199254740991"},{"v":"9007199254740992"},{"v":"9007199254740993"}]

select cast(value as text) as v from generate_series(-9007199254740993, -9007199254740990) limit 6;
→ [{"v":"-9007199254740993"},{"v":"-9007199254740992"},{"v":"-9007199254740991"},{"v":"-9007199254740990"}]

select cast(value as text) as v from generate_series('9007199254740993', '9007199254740994') limit 4;
→ [{"v":"9007199254740993"},{"v":"9007199254740994"}]

-- A series value used as a seek key against an integer primary key
create table series_seek (pid integer primary key);
insert into series_seek values (1), (2), (3);

select g.value as value, (select count(*) from series_seek p where p.pid < g.value) as below from generate_series(0.5, 3) g;
→ [{"value":1,"below":0},{"value":2,"below":1},{"value":3,"below":2}]

drop table series_seek;
