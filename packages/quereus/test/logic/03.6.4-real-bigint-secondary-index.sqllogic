-- 03.6.4-real-bigint-secondary-index.sqllogic
--
-- requires-capability: standalone-index-ddl
--
-- Carved out of 03.6-type-system's "REAL comparator against a bigint operand past 2^53"
-- regression section: these scenarios reach the REAL comparator through a secondary index
-- built with a standalone `create index`, which not every backend implements, and the
-- `-- requires-capability:` directive is whole-file. The primary-key arm of the same
-- regression needs no index DDL and stays in 03.6.
--
-- Regression: REAL_TYPE.compare used to assert its operands were `number` and call isNaN()
-- on them; isNaN() throws on a bigint. A REAL column compared against an integer literal
-- past 2^53 (which the engine keeps as bigint) hit this on every index/primary-key lookup.
-- Must order by exact value, not throw.

CREATE TABLE real_big (id INTEGER PRIMARY KEY, r REAL);
CREATE INDEX real_big_ir ON real_big(r);
INSERT INTO real_big VALUES (1, 5.0), (2, 9007199254740992.0);

-- Secondary index: equality against a bigint that doesn't match any stored REAL
select id from real_big where r = 9007199254740993;
→ []

-- Secondary index: greater-than against a bigint
select id from real_big where r > 9007199254740993;
→ []

-- Secondary index: less-than against a bigint one past the stored REAL. Both rows
-- must come back — had the bigint been coerced through Number() it would round
-- down to 9007199254740992 and drop row 2.
select id from real_big where r < 9007199254740993 order by id;
→ [{"id":1},{"id":2}]

-- ...and the exact stored value excludes itself, which the rounded form would not.
select id from real_big where r < 9007199254740992 order by id;
→ [{"id":1}]

-- Negative bigint past -2^53, below everything stored
select id from real_big where r > -9007199254740993 order by id;
→ [{"id":1},{"id":2}]

-- Secondary index: IN-list mixing a bigint and a plain number
select id from real_big where r in (9007199254740993, 5) order by id;
→ [{"id":1}]

select id from real_big where r in (9007199254740992, 5) order by id;
→ [{"id":1},{"id":2}]

DROP TABLE real_big;

-- NULL in an indexed REAL column still sorts first and never reaches the numeric path
-- (columns default NOT NULL in Quereus, hence the explicit `null`)
CREATE TABLE real_big_null (id INTEGER PRIMARY KEY, r REAL null);
CREATE INDEX real_big_null_ir ON real_big_null(r);
INSERT INTO real_big_null VALUES (1, 5.0), (2, 9007199254740992.0), (3, NULL);

select id from real_big_null where r < 9007199254740993 order by id;
→ [{"id":1},{"id":2}]

select id from real_big_null order by r, id;
→ [{"id":3},{"id":1},{"id":2}]

DROP TABLE real_big_null;

