-- 07.9.1-in-value-list-composite-index.sqllogic
--
-- requires-capability: standalone-index-ddl
--
-- Carved out of 07.9-in-value-list: every other scenario there reaches the IN
-- multi-seek path through an inline PRIMARY KEY or UNIQUE column (auto-indexed),
-- so the file needs no index DDL. This one scenario builds a standalone composite
-- `create index` to reach the two-column cross-product form of the same seek, and
-- would otherwise have cost a backend without first-class CREATE INDEX the entire
-- IN-value-list file.
--
-- Subject: the memory-vtab IN multi-seek over a COMPOSITE index — the a×b seek-key
-- cross-product must drop NULL-bearing tuples and dedup by primary key, so duplicate
-- list values never multiply matches.

-- ===== Composite-index IN (cross-product) with a duplicate and a NULL =====

create table c (id integer primary key, a integer, b integer);
create index idx_ab on c(a, b);
insert into c values (1, 1, 10), (2, 1, 20), (3, 2, 10), (4, 2, 20);

-- Cross-product (a∈{1,1} × b∈{10,null}): the NULL-bearing tuples drop, the
-- (1,10) duplicate collapses → a single row.
select id from c where a in (1, 1) and b in (10, null) order by id;
→ [{"id":1}]

-- Duplicate values on both columns must not multiply matches.
select id from c where a in (1, 2, 2) and b in (10, 20, 20) order by id;
→ [{"id":1},{"id":2},{"id":3},{"id":4}]

-- Duplicate + NULL collapsing to a two-row subset.
select id from c where a in (1, 1, 2) and b in (10, null) order by id;
→ [{"id":1},{"id":3}]

select distinct id from c where a in (1, 1, 2) and b in (10, null) order by id;
→ [{"id":1},{"id":3}]

drop table c;

-- ===== Bound equality on one column + IN list on the other (composite seek) =====
-- A plain `= ?` component must seek on its bound expression, not on an empty key.

create table t (id text primary key, a text, b text);
create index t_ab on t(a, b);
insert into t values ('1','x','p'), ('2','x','q'), ('3','y','p'), ('4','x','r');

-- params: ["x"]
select id from t where a = ? and b in ('p','q') order by id;
→ [{"id":"1"},{"id":"2"}]

-- params: ["x", "p", "q"]
select id from t where a = ? and b in (?,?) order by id;
→ [{"id":"1"},{"id":"2"}]

-- params: ["x", "y", "p"]
select id from t where a in (?,?) and b = ? order by id;
→ [{"id":"1"},{"id":"3"}]

select id from t where a in ('x','y') and b = 'p' order by id;
→ [{"id":"1"},{"id":"3"}]

drop table t;

-- Same shapes on a composite primary key.
create table tk (a text, b text, primary key (a, b));
insert into tk values ('x','p'), ('x','q'), ('y','p');

-- params: ["x"]
select a, b from tk where a = ? and b in ('p','q') order by a, b;
→ [{"a":"x","b":"p"},{"a":"x","b":"q"}]

-- params: ["x", "y", "p"]
select a, b from tk where a in (?,?) and b = ? order by a, b;
→ [{"a":"x","b":"p"},{"a":"y","b":"p"}]

drop table tk;
