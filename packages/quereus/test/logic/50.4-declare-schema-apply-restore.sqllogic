-- Declarative schema: a migration that fails partway is unwound, so the catalog is back where
-- the apply found it. Tightening a named constraint whose new body the existing rows violate
-- is the motivating case: the plan is DROP CONSTRAINT + ADD CONSTRAINT, the re-add fails its
-- existing-row validation, and the undo journal re-adds the OLD constraint — which must not
-- only be back in the catalog but still be enforced. Runs on both backends
-- (see docs/schema-declarative.md § Failure and restoration; the executor is runBatchedMigrationLoop).

-- ===================================
-- 1. CHECK tightened against a violating row
-- ===================================

create table t_ck (id integer primary key, v integer, constraint ck_v check (v > 0));
insert into t_ck values (1, 5);

declare schema main {
	table t_ck {
		id integer primary key,
		v integer,
		constraint ck_v check (v > 10)
	}
}

-- run

diff schema main;
→ [{"ddl": "ALTER TABLE t_ck DROP CONSTRAINT ck_v"}, {"ddl": "ALTER TABLE t_ck ADD constraint ck_v check (v > 10)"}]

-- The re-add fails over the row v = 5; the DROP that preceded it is undone.
apply schema main;
-- error: ck_v

-- The row is untouched, the old rule is back, and it is still enforced.
select v from t_ck;
→ [{"v": 5}]

insert into t_ck values (2, -1);
-- error: CHECK constraint failed

insert into t_ck values (2, 7);

-- run

-- Re-diffing produces the original plan again: nothing about the failure was cached.
diff schema main;
→ [{"ddl": "ALTER TABLE t_ck DROP CONSTRAINT ck_v"}, {"ddl": "ALTER TABLE t_ck ADD constraint ck_v check (v > 10)"}]

drop table t_ck;

-- ===================================
-- 2. UNIQUE tightened against duplicate rows
-- ===================================

create table t_uq (id integer primary key, a integer, b integer, constraint uq_ab unique (a, b));
insert into t_uq values (1, 1, 1), (2, 1, 2);

declare schema main {
	table t_uq {
		id integer primary key,
		a integer,
		b integer,
		constraint uq_ab unique (a)
	}
}

-- run

apply schema main;
-- error: uq_ab

-- The old two-column rule is back: a duplicate (a, b) is refused, a duplicate a alone is not.
insert into t_uq values (3, 1, 1);
-- error: UNIQUE constraint failed

insert into t_uq values (3, 1, 3);

-- run

select count(*) as n from t_uq;
→ [{"n": 3}]

drop table t_uq;

-- ===================================
-- 3. FOREIGN KEY re-targeted at a column the child rows do not match
-- ===================================

create table p (id integer primary key, alt integer, constraint uq_alt unique (alt));
insert into p values (1, 100);
create table c (id integer primary key, pid integer, constraint fk_p foreign key (pid) references p(id));
insert into c values (1, 1);

declare schema main {
	table p {
		id integer primary key,
		alt integer,
		constraint uq_alt unique (alt)
	}
	table c {
		id integer primary key,
		pid integer,
		constraint fk_p foreign key (pid) references p(alt)
	}
}

-- run

-- pid = 1 is a p.id, not a p.alt, so the re-add fails and the old reference is restored.
apply schema main;
-- error: fk_p

insert into c values (2, 999);
-- error: constraint failed: fk_p

insert into c values (2, 1);

-- run

select count(*) as n from c;
→ [{"n": 2}]

drop table c;
drop table p;

-- ===================================
-- 4. A multi-step plan: the steps that landed before the failure are taken back
-- ===================================

create table t (id integer primary key, v text null);
insert into t values (1, 'a');

declare schema main {
	table t {
		id integer primary key,
		v text null,
		w integer not null
	}
	table n1 {
		id integer primary key
	}
}

-- run

-- create table n1 lands, then ALTER TABLE t ADD COLUMN w fails over the existing row.
diff schema main;
→ [{"ddl": "create table n1 (id integer primary key)"}, {"ddl": "ALTER TABLE t ADD COLUMN w integer not null"}]

apply schema main;
-- error: NOT NULL constraint failed

-- n1 is gone again and t has no w.
select * from n1;
-- error: not found

select * from t;
→ [{"id": 1, "v": "a"}]

diff schema main;
→ [{"ddl": "create table n1 (id integer primary key)"}, {"ddl": "ALTER TABLE t ADD COLUMN w integer not null"}]

-- ===================================
-- 5. The same failure inside an explicit transaction: savepoint-like
-- ===================================

begin;
insert into t values (2, 'b');
apply schema main;
-- error: NOT NULL constraint failed

-- The transaction is still open and usable after the restored failure.
insert into t values (3, 'c');
commit;

-- run

select id from t order by id;
→ [{"id": 1}, {"id": 2}, {"id": 3}]

select * from n1;
-- error: not found

-- Once the violating rows are gone the same declaration applies cleanly.
delete from t;
apply schema main;

-- run

diff schema main;
→ []

drop table n1;
drop table t;

-- ===================================
-- 6. An added column's inline constraints are taken back with it
-- ===================================

-- DROP COLUMN does not remove a CHECK that names the column, even its own, so undoing this ADD
-- COLUMN has to drop both CHECKs first. The inline UNIQUE goes with the column.
create table t_inl (id integer primary key, b integer null);
insert into t_inl values (1, 1), (2, 1);

declare schema main {
	table t_inl {
		id integer primary key,
		b integer null,
		d integer null check (d > 0) constraint d_lt check (d < 100) unique,
		constraint ub unique (b)
	}
}

-- run

diff schema main;
→ [{"ddl": "ALTER TABLE t_inl ADD COLUMN d integer null check (d > 0) constraint d_lt check (d < 100) unique"}, {"ddl": "ALTER TABLE t_inl ADD constraint ub unique (b)"}]

-- ADD constraint ub fails over the duplicate b, after the column has landed.
apply schema main;
-- error: ub

select * from t_inl order by id;
→ [{"id": 1, "b": 1}, {"id": 2, "b": 1}]

diff schema main;
→ [{"ddl": "ALTER TABLE t_inl ADD COLUMN d integer null check (d > 0) constraint d_lt check (d < 100) unique"}, {"ddl": "ALTER TABLE t_inl ADD constraint ub unique (b)"}]

drop table t_inl;

-- ===================================
-- 7. New tables that refer to objects the same migration adds do not block the unwind
-- ===================================

-- CREATE TABLE does not check what it refers to, so these forward references are accepted, and
-- the exact-reverse unwind removes t.d, zz and v while n, aa and k still refer to them.
create table t (id integer primary key, b integer null);
insert into t values (1, 1), (2, 1);

declare schema main {
	table t {
		id integer primary key,
		b integer null,
		d integer null unique,
		constraint ub unique (b)
	}
	table n {
		id integer primary key,
		x integer null references t(d),
		y integer null check (y > (select max(d) from t)),
		z integer null default ((select max(d) from t))
	}
	table aa {
		id integer primary key,
		x integer null check (x > (select max(id) from zz))
	}
	view v as select id from t
	table k {
		id integer primary key,
		x integer null check (x > (select max(id) from v))
	}
	table zz {
		id integer primary key
	}
}

-- run

apply schema main;
-- error: ub

select * from t order by id;
→ [{"id": 1, "b": 1}, {"id": 2, "b": 1}]

select * from n;
-- error: not found

select * from zz;
-- error: not found

-- Once the duplicate is gone the same declaration applies, and its references resolve.
update t set b = 2 where id = 2;
apply schema main;
insert into t (id, b, d) values (3, 3, 30);
insert into n (id, x, y) values (1, 30, 31);

-- run

select id, x, y, z from n;
→ [{"id": 1, "x": 30, "y": 31, "z": 30}]

-- The guards the unwind stood down are back on.
drop view v;
-- error: on table 'k'

drop table k;
drop view v;
drop table n;
drop table aa;
drop table zz;
drop table t;

-- ===================================
-- 8. A reference that was already dangling before the apply does not block the unwind
-- ===================================

-- e's CHECK names t.d and f's foreign key names zz, neither of which exists yet. The apply adds
-- both, then fails, and taking them back returns e and f to the dangling state they started in.
create table t (id integer primary key, b integer null);
insert into t values (1, 1), (2, 1);
create table e (id integer primary key, x integer null check (x > (select max(d) from t)));
create table f (id integer primary key, z integer null references zz(id));
pragma foreign_keys = off;
insert into f values (1, 1);
pragma foreign_keys = on;

declare schema main {
	table t {
		id integer primary key,
		b integer null,
		d integer null,
		constraint ub unique (b)
	}
	table e {
		id integer primary key,
		x integer null check (x > (select max(d) from t))
	}
	table f {
		id integer primary key,
		z integer null references zz(id)
	}
	table zz {
		id integer primary key
	}
}

-- run

apply schema main;
-- error: ub

select * from t order by id;
→ [{"id": 1, "b": 1}, {"id": 2, "b": 1}]

select * from f;
→ [{"id": 1, "z": 1}]

select * from zz;
-- error: not found

drop table f;
drop table e;
drop table t;

-- ===================================
-- 9. An existing assertion that comes to name what the plan added does not block the unwind
-- ===================================

-- a's bare d means u.d until t gains a d, which the inner scope then binds first. The assertion
-- was never edited, and undoing the ADD COLUMN is what makes it mean u.d again.
create table t (id integer primary key, b integer null);
insert into t values (1, 1), (2, 1);
create table u (id integer primary key, d integer null);
create assertion a check (not exists (select 1 from u where exists (select 1 from t where t.id = u.id and d < 0)));

declare schema main {
	table t {
		id integer primary key,
		b integer null,
		d integer null,
		constraint ub unique (b)
	}
	table u {
		id integer primary key,
		d integer null
	}
	assertion a check (not exists (select 1 from u where exists (select 1 from t where t.id = u.id and d < 0)))
}

-- run

apply schema main;
-- error: ub

select * from t order by id;
→ [{"id": 1, "b": 1}, {"id": 2, "b": 1}]

insert into u values (1, -1);
-- error: Integrity assertion failed: a

drop assertion a;
drop table u;
drop table t;

-- Same for the table verb: a's bare zz means temp.zz until main gains a zz, earlier on its path.
pragma schema_path = 'main,temp';
create table t (id integer primary key, b integer null);
insert into t values (1, 1), (2, 1);
create table temp.zz (id integer primary key);
create assertion a check (not exists (select 1 from zz where id < 0));

declare schema main {
	table t {
		id integer primary key,
		b integer null,
		constraint ub unique (b)
	}
	table zz {
		id integer primary key
	}
	assertion a check (not exists (select 1 from zz where id < 0))
}

-- run

apply schema main;
-- error: ub

select * from main.zz;
-- error: not found

drop assertion a;
drop table temp.zz;
drop table t;
pragma schema_path = 'main';

-- ===================================
-- 10. Tables altered together: the order they are written in does not decide the outcome
-- ===================================

-- u is written first and its foreign key names a column t gains, so the plan runs t's ADD COLUMN
-- ahead of u's ADD constraint. Then ub fails over the duplicate b, and both are taken back.
create table t (id integer primary key, b integer null);
create table u (id integer primary key, y integer null);
insert into t values (1, 1), (2, 1);

declare schema main {
	table u {
		id integer primary key,
		y integer null,
		constraint fu foreign key (y) references t(d)
	}
	table t {
		id integer primary key,
		b integer null,
		d integer null unique,
		constraint ub unique (b)
	}
}

-- run

diff schema main;
→ [{"ddl": "ALTER TABLE t ADD COLUMN d integer null unique"}, {"ddl": "ALTER TABLE u ADD constraint fu foreign key (y) references t(d)"}, {"ddl": "ALTER TABLE t ADD constraint ub unique (b)"}]

apply schema main;
-- error: ub

select * from t order by id;
→ [{"id": 1, "b": 1}, {"id": 2, "b": 1}]

select * from u;
→ []

-- Once the duplicate is gone the same declaration applies, and the foreign key is enforced.
update t set b = 2 where id = 2;
apply schema main;
update t set d = 30 where id = 1;
insert into u values (1, 30);

-- run

diff schema main;
→ []

insert into u values (2, 99);
-- error: fu

-- The reverse: t is written first and gives up the column u's foreign key names. u's DROP CONSTRAINT
-- runs ahead of t's DROP COLUMN.
delete from u;

declare schema main {
	table t {
		id integer primary key,
		b integer null,
		constraint ub unique (b)
	}
	table u {
		id integer primary key,
		y integer null
	}
}

-- run

apply schema main;

-- run

diff schema main;
→ []

drop table u;
drop table t;

-- A DEFAULT has no constraint to drop first, so u's column goes before the t column it reads.
create table t (id integer primary key, d integer null);
create table u (id integer primary key, z integer null default ((select max(d) from t)));

declare schema main {
	table t {
		id integer primary key
	}
	table u {
		id integer primary key
	}
}

-- run

diff schema main;
→ [{"ddl": "ALTER TABLE u DROP COLUMN z"}, {"ddl": "ALTER TABLE t DROP COLUMN d"}]

apply schema main;

-- run

diff schema main;
→ []

drop table u;
drop table t;

-- c's inline foreign key names p's implicit key, so c's column has to arrive after p's key change.
-- Over a row with z = 50, it is validated against the new key.
create table p (a integer, b integer, d integer, primary key (a, b));
create table c (id integer primary key);
insert into p values (1, 1, 50);
insert into c values (1);

declare schema main {
	table p {
		a integer,
		b integer,
		d integer primary key
	}
	table c {
		id integer primary key,
		z integer null default 50 references p
	}
}

-- run

apply schema main;

-- run

diff schema main;
→ []

select z from c;
→ [{"z": 50}]

drop table c;
drop table p;

-- v reads a column t gains, so it is created after t's ADD COLUMN, written first or not.
-- Then ub fails over the duplicate b, and the view goes back before the column does.
create table t (id integer primary key, b integer null);
insert into t values (1, 1), (2, 1);

declare schema main {
	view v as select d from t
	table t {
		id integer primary key,
		b integer null,
		d integer null,
		constraint ub unique (b)
	}
}

-- run

diff schema main;
→ [{"ddl": "ALTER TABLE t ADD COLUMN d integer null"}, {"ddl": "create view v as select d from t"}, {"ddl": "ALTER TABLE t ADD constraint ub unique (b)"}]

apply schema main;
-- error: ub

select name from schema() where type = 'view';
→ []

select * from t order by id;
→ [{"id": 1, "b": 1}, {"id": 2, "b": 1}]

update t set b = 2 where id = 2;
apply schema main;

-- run

diff schema main;
→ []

select d from v order by d;
→ [{"d": null}, {"d": null}]

drop view v;
drop table t;

-- ===================================
-- 11. A constraint the undo re-adds is restored whether or not it would pass a fresh check
-- ===================================

-- Each e_* table gives up a constraint that a new ADD CONSTRAINT would refuse, then ub fails. The
-- undo re-adds them all, and any one refusal would stop the unwind and be named in the error.
create table t (id integer primary key, b integer null);
insert into t values (1, 1), (2, 1);

-- The row was valid when written, then o grew past it.
create table o (id integer primary key);
insert into o values (1);
create table e_grown (id integer primary key, x integer null, constraint c check (x > (select max(id) from o)));
insert into e_grown values (1, 5);
insert into o values (10);

-- The CHECK reads a table that does not exist, so its scan cannot even be prepared.
create table e_absent (id integer primary key, x integer null, constraint c check (x > (select max(id) from zz)));

-- Orphans written with enforcement off, one against a parent that exists and one against a parent that does not.
create table p (id integer primary key);
insert into p values (1);
create table e_orphan (id integer primary key, x integer null, constraint c foreign key (x) references p(id));
create table e_noparent (id integer primary key, x integer null, constraint c foreign key (x) references zz(id));
pragma foreign_keys = off;
insert into e_orphan values (1, 99);
insert into e_noparent values (1, 99);
pragma foreign_keys = on;

-- Both parents arrive after the foreign key naming them, with a shape it could not be declared against now.
create table e_arity (id integer primary key, x integer null, constraint c foreign key (x) references p2);
create table p2 (a integer, b integer, primary key (a, b));
create table e_coll (id integer primary key, x text collate nocase null, constraint c foreign key (x) references p3(k));
create table p3 (id integer primary key, k text collate rtrim null);

declare schema main {
	table t {
		id integer primary key,
		b integer null,
		constraint ub unique (b)
	}
	table o {
		id integer primary key
	}
	table e_grown {
		id integer primary key,
		x integer null
	}
	table e_absent {
		id integer primary key,
		x integer null
	}
	table p {
		id integer primary key
	}
	table e_orphan {
		id integer primary key,
		x integer null
	}
	table e_noparent {
		id integer primary key,
		x integer null
	}
	table e_arity {
		id integer primary key,
		x integer null
	}
	table p2 {
		a integer,
		b integer,
		primary key (a, b)
	}
	table e_coll {
		id integer primary key,
		x text collate nocase null
	}
	table p3 {
		id integer primary key,
		k text collate rtrim null
	}
}

-- run

apply schema main;
-- error: ub

-- A restored catalog plans every DROP CONSTRAINT again; an unrestored one has nothing left to drop.
diff schema main;
→ [{"ddl": "ALTER TABLE e_grown DROP CONSTRAINT c"}, {"ddl": "ALTER TABLE e_absent DROP CONSTRAINT c"}, {"ddl": "ALTER TABLE e_orphan DROP CONSTRAINT c"}, {"ddl": "ALTER TABLE e_noparent DROP CONSTRAINT c"}, {"ddl": "ALTER TABLE e_arity DROP CONSTRAINT c"}, {"ddl": "ALTER TABLE e_coll DROP CONSTRAINT c"}, {"ddl": "ALTER TABLE t ADD constraint ub unique (b)"}]

-- The rows that break their restored constraints are still there.
select * from e_grown;
→ [{"id": 1, "x": 5}]

select * from e_orphan;
→ [{"id": 1, "x": 99}]

select * from e_noparent;
→ [{"id": 1, "x": 99}]

-- The restored constraints are enforced on new rows wherever they can be evaluated.
insert into e_grown values (2, 5);
-- error: CHECK constraint failed: c

insert into e_grown values (2, 50);
insert into e_orphan values (2, 98);
-- error: constraint failed: c

insert into e_orphan values (2, 1);

-- run

drop table e_coll;
drop table e_arity;
drop table e_noparent;
drop table e_orphan;
drop table e_absent;
drop table e_grown;
drop table p3;
drop table p2;
drop table p;
drop table o;
drop table t;

-- ===================================
-- 12. A view a CHECK reads can be redefined: the guard on its drop lets it through because the
-- plan creates it again, and the CHECK is then judged against the existing rows
-- ===================================

create table r_t (id integer primary key, n integer);
insert into r_t values (1, 10);
create view r_v as select sum(n) as s from r_t;
create table r_p (id integer primary key, u integer, check (u <= (select s from r_v)));
insert into r_p values (1, 5);

declare schema main {
	table r_t { id integer primary key, n integer }
	view r_v as select sum(n) + 1 as s from r_t
	table r_p { id integer primary key, u integer, check (u <= (select s from r_v)) }
}

-- run

apply schema main;

diff schema main;
→ []

-- The CHECK reads the new view: 11 fits only under its new sum.
insert into r_p values (2, 11);
insert into r_p values (3, 12);
-- error: CHECK constraint failed

select id from r_p order by id;
→ [{"id": 1}, {"id": 2}]

-- The table can be altered in the same plan, in the stretch where the view is gone.
declare schema main {
	table r_t { id integer primary key, n integer }
	view r_v as select sum(n) + 2 as s from r_t
	table r_p { id integer primary key, u integer, w integer default 3, check (u <= (select s from r_v)) }
	index r_p_u on r_p (u)
}

-- run

apply schema main;

select id, w from r_p order by id;
→ [{"id": 1, "w": 3}, {"id": 2, "w": 3}]

insert into r_p (id, u) values (3, 12);

drop table r_p;
drop view r_v;
drop table r_t;

-- ===================================
-- 13. The same through a chain of views, where the CHECK's body does not name what changes
-- ===================================

create table c_t (id integer primary key, n integer);
insert into c_t values (1, 10);
create view c_v1 as select sum(n) as s from c_t;
create view c_v2 as select s from c_v1;
create view c_v3 as select s from c_v2;
create table c_p (id integer primary key, u integer, constraint c_ck check (u <= (select s from c_v3)));
insert into c_p values (1, 5);

declare schema main {
	table c_t { id integer primary key, n integer }
	view c_v1 as select sum(n) + 1 as s from c_t
	view c_v2 as select s from c_v1
	view c_v3 as select s from c_v2
	table c_p { id integer primary key, u integer, constraint c_ck check (u <= (select s from c_v3)) }
}

-- run

apply schema main;

diff schema main;
→ []

insert into c_p values (2, 11);
insert into c_p values (3, 12);
-- error: CHECK constraint failed

-- ===================================
-- 14. A view removed while a CHECK still reaches it stays refused, directly or mid-chain
-- ===================================

declare schema main {
	table c_t { id integer primary key, n integer }
	view c_v1 as select sum(n) + 1 as s from c_t
	view c_v3 as select s from c_v2
	table c_p { id integer primary key, u integer, constraint c_ck check (u <= (select s from c_v3)) }
}

-- run

apply schema main;
-- error: cannot drop view 'main.c_v2': CHECK constraint 'c_ck' on table 'c_p' reaches it through view 'c_v3'

select s from c_v3;
→ [{"s": 11}]

declare schema main {
	table c_t { id integer primary key, n integer }
	view c_v1 as select sum(n) + 1 as s from c_t
	view c_v2 as select s from c_v1
	table c_p { id integer primary key, u integer, constraint c_ck check (u <= (select s from c_v3)) }
}

-- run

apply schema main;
-- error: cannot drop view 'main.c_v3': it is referenced by CHECK constraint 'c_ck'

select s from c_v3;
→ [{"s": 11}]

-- A hinted rename is a different name on each side, so nothing comes back under the name the CHECK reads.
declare schema main {
	table c_t { id integer primary key, n integer }
	view c_v1 as select sum(n) + 1 as s from c_t
	view c_v2 as select s from c_v1
	view c_v4 as select s from c_v2 with tags ("quereus.previous_name" = 'c_v3')
	table c_p { id integer primary key, u integer, constraint c_ck check (u <= (select s from c_v3)) }
}

-- run

apply schema main;
-- error: cannot drop view 'main.c_v3': it is referenced by CHECK constraint 'c_ck'

drop table c_p;
drop view c_v3;
drop view c_v2;
drop view c_v1;
drop table c_t;

-- ===================================
-- 15. A new view the existing rows violate fails the apply and brings the old view back. The
-- CHECK's first conjunct is lifted by the optimizer as a fact about stored rows, and the scan
-- must find the violator all the same
-- ===================================

create table v_t (id integer primary key, n integer);
insert into v_t values (1, 10);
create view v_v as select sum(n) as s from v_t;
create table v_p (id integer primary key, u integer, constraint v_ck check (u > 0 and u <= (select s from v_v)));
insert into v_p values (1, 5);

declare schema main {
	table v_t { id integer primary key, n integer }
	view v_v as select sum(n) - 9 as s from v_t
	table v_p { id integer primary key, u integer, constraint v_ck check (u > 0 and u <= (select s from v_v)) }
}

-- run

apply schema main;
-- error: CHECK constraint 'v_ck' on table 'v_p' reads recreated 'main.v_v' and fails: CHECK constraint failed: v_ck

select s from v_v;
→ [{"s": 10}]

-- ===================================
-- 16. A new view without the column the CHECK reads fails even with no rows to scan
-- ===================================

delete from v_p;

declare schema main {
	table v_t { id integer primary key, n integer }
	view v_v as select sum(n) as renamed from v_t
	table v_p { id integer primary key, u integer, constraint v_ck check (u > 0 and u <= (select s from v_v)) }
}

-- run

apply schema main;
-- error: Column not found: s

select s from v_v;
→ [{"s": 10}]

-- ===================================
-- 17. A CHECK that is not a row invariant owes the existing rows nothing, as with ADD CONSTRAINT
-- ===================================

alter table v_p drop constraint v_ck;
alter table v_p add constraint v_ck check on insert (u <= (select s from v_v));

declare schema main {
	table v_t { id integer primary key, n integer }
	view v_v as select sum(n) as renamed from v_t
	table v_p { id integer primary key, u integer, constraint v_ck check on insert (u <= (select s from v_v)) }
}

-- run

apply schema main;

select renamed from v_v;
→ [{"renamed": 10}]

-- So it surfaces on the next write that uses it.
insert into v_p values (1, 5);
-- error: Column not found: s

drop table v_p;

-- A DEFAULT gets no check either, as with SET DEFAULT.
create table v_d (id integer primary key, w integer default ((select renamed from v_v)));

declare schema main {
	table v_t { id integer primary key, n integer }
	view v_v as select sum(n) as other from v_t
	table v_d { id integer primary key, w integer default ((select renamed from v_v)) }
}

-- run

apply schema main;

insert into v_d (id) values (1);
-- error: Column not found: renamed

drop table v_d;
drop view v_v;
drop table v_t;

-- ===================================
-- 18. An assertion reading a redefined view through a chain is dropped and recreated around it,
-- and that recreate plans its body against the new view
-- ===================================

create table a_t (id integer primary key, n integer);
insert into a_t values (1, 10);
create view a_v1 as select sum(n) as s from a_t;
create view a_v2 as select s from a_v1;
create assertion a_ck check (not exists (select 1 from a_v2 where s < 0));

declare schema main {
	table a_t { id integer primary key, n integer }
	view a_v1 as select sum(n) + 1 as s from a_t
	view a_v2 as select s from a_v1
	assertion a_ck check (not exists (select 1 from a_v2 where s < 0))
}

-- run

apply schema main;

diff schema main;
→ []

select s from a_v2;
→ [{"s": 11}]

declare schema main {
	table a_t { id integer primary key, n integer }
	view a_v1 as select sum(n) as renamed from a_t
	view a_v2 as select renamed as other from a_v1
	assertion a_ck check (not exists (select 1 from a_v2 where s < 0))
}

-- run

apply schema main;
-- error: Cannot create assertion

select s from a_v2;
→ [{"s": 11}]

-- A view going away with an assertion still reading it through a chain stays refused at its drop.
declare schema main {
	table a_t { id integer primary key, n integer }
	view a_v2 as select s from a_v1
	assertion a_ck check (not exists (select 1 from a_v2 where s < 0))
}

-- run

apply schema main;
-- error: cannot drop view 'main.a_v1': assertion 'a_ck' reaches it through view 'a_v2'

select s from a_v2;
→ [{"s": 11}]

drop assertion a_ck;
drop view a_v2;
drop view a_v1;

-- A table going away is refused the same way, with its rows intact: letting the assertion go
-- first would fail at its recreate, after the drop had already destroyed them.
create view a_v3 as select n from a_t;
create assertion a_ck check (not exists (select 1 from a_v3 where n < 0));

declare schema main {
	view a_v3 as select n from a_t
	assertion a_ck check (not exists (select 1 from a_v3 where n < 0))
}

-- run

apply schema main;
-- error: cannot drop table 'main.a_t': assertion 'a_ck' reaches it through view 'a_v3'

select n from a_t;
→ [{"n": 10}]

drop assertion a_ck;
drop view a_v3;

-- ===================================
-- 19. The same assertion rule through a maintained table: one that still reads the view after the
-- plan, and one the plan moves off it, which the catalog says still reads it when the view drops
-- ===================================

create view m_v as select sum(n) as s from a_t;
create materialized view m_kept as select s from m_v;
create materialized view m_moved as select s from m_v;
create assertion m_kept_ck check (not exists (select 1 from m_kept where s < 0));
create assertion m_moved_ck check (not exists (select 1 from m_moved where s < 0));

declare schema main {
	table a_t { id integer primary key, n integer }
	view m_v as select sum(n) + 1 as s from a_t
	materialized view m_kept as select s from m_v
	materialized view m_moved as select sum(n) as s from a_t
	assertion m_kept_ck check (not exists (select 1 from m_kept where s < 0))
	assertion m_moved_ck check (not exists (select 1 from m_moved where s < 0))
}

-- run

apply schema main;

diff schema main;
→ []

select s from m_v;
→ [{"s": 11}]

drop assertion m_moved_ck;
drop assertion m_kept_ck;
drop materialized view m_moved;
drop materialized view m_kept;
drop view m_v;
drop table a_t;
