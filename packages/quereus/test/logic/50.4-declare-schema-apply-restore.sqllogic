-- Declarative schema: a migration that fails partway is unwound, so the catalog is back where
-- the apply found it. Tightening a named constraint whose new body the existing rows violate
-- is the motivating case: the plan is DROP CONSTRAINT + ADD CONSTRAINT, the re-add fails its
-- existing-row validation, and the undo journal re-adds the OLD constraint — which must not
-- only be back in the catalog but still be enforced. Runs on both backends
-- (see docs/schema.md § Failure and restoration; the executor is runBatchedMigrationLoop).

-- ===================================
-- 1. CHECK tightened against a violating row
-- ===================================

create table t_ck (id integer primary key, v integer, constraint ck_v check (v > 0));
insert into t_ck values (1, 5);

declare schema main {
	table t_ck {
		id integer primary key,
		v integer,
		constraint ck_v check (v > 10)
	}
}

-- run

diff schema main;
→ [{"ddl": "ALTER TABLE t_ck DROP CONSTRAINT ck_v"}, {"ddl": "ALTER TABLE t_ck ADD constraint ck_v check (v > 10)"}]

-- The re-add fails over the row v = 5; the DROP that preceded it is undone.
apply schema main;
-- error: ck_v

-- The row is untouched, the old rule is back, and it is still enforced.
select v from t_ck;
→ [{"v": 5}]

insert into t_ck values (2, -1);
-- error: CHECK constraint failed

insert into t_ck values (2, 7);

-- run

-- Re-diffing produces the original plan again: nothing about the failure was cached.
diff schema main;
→ [{"ddl": "ALTER TABLE t_ck DROP CONSTRAINT ck_v"}, {"ddl": "ALTER TABLE t_ck ADD constraint ck_v check (v > 10)"}]

drop table t_ck;

-- ===================================
-- 2. UNIQUE tightened against duplicate rows
-- ===================================

create table t_uq (id integer primary key, a integer, b integer, constraint uq_ab unique (a, b));
insert into t_uq values (1, 1, 1), (2, 1, 2);

declare schema main {
	table t_uq {
		id integer primary key,
		a integer,
		b integer,
		constraint uq_ab unique (a)
	}
}

-- run

apply schema main;
-- error: uq_ab

-- The old two-column rule is back: a duplicate (a, b) is refused, a duplicate a alone is not.
insert into t_uq values (3, 1, 1);
-- error: UNIQUE constraint failed

insert into t_uq values (3, 1, 3);

-- run

select count(*) as n from t_uq;
→ [{"n": 3}]

drop table t_uq;

-- ===================================
-- 3. FOREIGN KEY re-targeted at a column the child rows do not match
-- ===================================

create table p (id integer primary key, alt integer, constraint uq_alt unique (alt));
insert into p values (1, 100);
create table c (id integer primary key, pid integer, constraint fk_p foreign key (pid) references p(id));
insert into c values (1, 1);

declare schema main {
	table p {
		id integer primary key,
		alt integer,
		constraint uq_alt unique (alt)
	}
	table c {
		id integer primary key,
		pid integer,
		constraint fk_p foreign key (pid) references p(alt)
	}
}

-- run

-- pid = 1 is a p.id, not a p.alt, so the re-add fails and the old reference is restored.
apply schema main;
-- error: fk_p

insert into c values (2, 999);
-- error: constraint failed: fk_p

insert into c values (2, 1);

-- run

select count(*) as n from c;
→ [{"n": 2}]

drop table c;
drop table p;

-- ===================================
-- 4. A multi-step plan: the steps that landed before the failure are taken back
-- ===================================

create table t (id integer primary key, v text null);
insert into t values (1, 'a');

declare schema main {
	table t {
		id integer primary key,
		v text null,
		w integer not null
	}
	table n1 {
		id integer primary key
	}
}

-- run

-- create table n1 lands, then ALTER TABLE t ADD COLUMN w fails over the existing row.
diff schema main;
→ [{"ddl": "create table n1 (id integer primary key)"}, {"ddl": "ALTER TABLE t ADD COLUMN w integer not null"}]

apply schema main;
-- error: NOT NULL constraint failed

-- n1 is gone again and t has no w.
select * from n1;
-- error: not found

select * from t;
→ [{"id": 1, "v": "a"}]

diff schema main;
→ [{"ddl": "create table n1 (id integer primary key)"}, {"ddl": "ALTER TABLE t ADD COLUMN w integer not null"}]

-- ===================================
-- 5. The same failure inside an explicit transaction: savepoint-like
-- ===================================

begin;
insert into t values (2, 'b');
apply schema main;
-- error: NOT NULL constraint failed

-- The transaction is still open and usable after the restored failure.
insert into t values (3, 'c');
commit;

-- run

select id from t order by id;
→ [{"id": 1}, {"id": 2}, {"id": 3}]

select * from n1;
-- error: not found

-- Once the violating rows are gone the same declaration applies cleanly.
delete from t;
apply schema main;

-- run

diff schema main;
→ []

drop table n1;
drop table t;

-- ===================================
-- 6. An added column's inline constraints are taken back with it
-- ===================================

-- DROP COLUMN does not remove a CHECK that names the column, even its own, so undoing this ADD
-- COLUMN has to drop both CHECKs first. The inline UNIQUE goes with the column.
create table t_inl (id integer primary key, b integer null);
insert into t_inl values (1, 1), (2, 1);

declare schema main {
	table t_inl {
		id integer primary key,
		b integer null,
		d integer null check (d > 0) constraint d_lt check (d < 100) unique,
		constraint ub unique (b)
	}
}

-- run

diff schema main;
→ [{"ddl": "ALTER TABLE t_inl ADD COLUMN d integer null check (d > 0) constraint d_lt check (d < 100) unique"}, {"ddl": "ALTER TABLE t_inl ADD constraint ub unique (b)"}]

-- ADD constraint ub fails over the duplicate b, after the column has landed.
apply schema main;
-- error: ub

select * from t_inl order by id;
→ [{"id": 1, "b": 1}, {"id": 2, "b": 1}]

diff schema main;
→ [{"ddl": "ALTER TABLE t_inl ADD COLUMN d integer null check (d > 0) constraint d_lt check (d < 100) unique"}, {"ddl": "ALTER TABLE t_inl ADD constraint ub unique (b)"}]

drop table t_inl;

-- ===================================
-- 7. New tables that refer to objects the same migration adds do not block the unwind
-- ===================================

-- CREATE TABLE does not check what it refers to, so these forward references are accepted, and
-- the exact-reverse unwind removes t.d, zz and v while n, aa and k still refer to them.
create table t (id integer primary key, b integer null);
insert into t values (1, 1), (2, 1);

declare schema main {
	table t {
		id integer primary key,
		b integer null,
		d integer null unique,
		constraint ub unique (b)
	}
	table n {
		id integer primary key,
		x integer null references t(d),
		y integer null check (y > (select max(d) from t)),
		z integer null default ((select max(d) from t))
	}
	table aa {
		id integer primary key,
		x integer null check (x > (select max(id) from zz))
	}
	view v as select id from t
	table k {
		id integer primary key,
		x integer null check (x > (select max(id) from v))
	}
	table zz {
		id integer primary key
	}
}

-- run

apply schema main;
-- error: ub

select * from t order by id;
→ [{"id": 1, "b": 1}, {"id": 2, "b": 1}]

select * from n;
-- error: not found

select * from zz;
-- error: not found

-- Once the duplicate is gone the same declaration applies, and its references resolve.
update t set b = 2 where id = 2;
apply schema main;
insert into t (id, b, d) values (3, 3, 30);
insert into n (id, x, y) values (1, 30, 31);

-- run

select id, x, y, z from n;
→ [{"id": 1, "x": 30, "y": 31, "z": 30}]

-- The guards the unwind stood down are back on.
drop view v;
-- error: on table 'k'

drop table k;
drop view v;
drop table n;
drop table aa;
drop table zz;
drop table t;

-- ===================================
-- 8. A reference that was already dangling before the apply does not block the unwind
-- ===================================

-- e's CHECK names t.d and f's foreign key names zz, neither of which exists yet. The apply adds
-- both, then fails, and taking them back returns e and f to the dangling state they started in.
create table t (id integer primary key, b integer null);
insert into t values (1, 1), (2, 1);
create table e (id integer primary key, x integer null check (x > (select max(d) from t)));
create table f (id integer primary key, z integer null references zz(id));
pragma foreign_keys = off;
insert into f values (1, 1);
pragma foreign_keys = on;

declare schema main {
	table t {
		id integer primary key,
		b integer null,
		d integer null,
		constraint ub unique (b)
	}
	table e {
		id integer primary key,
		x integer null check (x > (select max(d) from t))
	}
	table f {
		id integer primary key,
		z integer null references zz(id)
	}
	table zz {
		id integer primary key
	}
}

-- run

apply schema main;
-- error: ub

select * from t order by id;
→ [{"id": 1, "b": 1}, {"id": 2, "b": 1}]

select * from f;
→ [{"id": 1, "z": 1}]

select * from zz;
-- error: not found

drop table f;
drop table e;
drop table t;
