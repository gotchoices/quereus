{
	"name": "@quereus/bundle",
	"version": "5.6.1",
	"type": "module",
	"description": "Save and load a Quereus database's schema and data as a single bundle.yaml file",
	"keywords": [
		"quereus",
		"sql",
		"database",
		"export",
		"import",
		"backup",
		"yaml"
	],
	"publisher": "Got Choices Foundation",
	"repository": {
		"type": "git",
		"url": "https://github.com/gotchoices/quereus.git",
		"directory": "packages/quereus-bundle"
	},
	"license": "MIT",
	"main": "dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"files": [
		"dist",
		"!**/*.tsbuildinfo"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		}
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "tsc",
		"lint": "echo 'No lint configured'",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"test": "cd ../.. && node --import ./packages/quereus-bundle/register.mjs node_modules/mocha/bin/mocha.js \"packages/quereus-bundle/test/**/*.spec.ts\" --reporter min --colors",
		"test:single": "cd ../.. && node --import ./packages/quereus-bundle/register.mjs node_modules/mocha/bin/mocha.js --bail"
	},
	"peerDependencies": {
		"@quereus/quereus": "workspace:^"
	},
	"dependencies": {
		"@quereus/quereus": "workspace:^",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.9.3",
		"chai": "^6.2.2",
		"mocha": "^11.7.6",
		"rimraf": "^6.1.3",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	}
}
